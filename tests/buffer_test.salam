// Unit tests for the minimal Buffer: cell access, clipping (writes outside
// the grid or the clip rect are dropped, never errors), multi-byte text,
// the shared-storage behavior that lets widgets draw through a copy, and
// resize (new dimensions, blank grid, whole-grid clip, negatives to zero).
// Also the ansi() serialization (a cursor move per row, styles emitted only
// where they change, trailing reset), the styles put_str writes, off-grid
// and edge starts, the clip-vs-grid split (set and fill obey clip; get,
// clear and row_text do not), and the per-copy focused flag. Finally the
// front-buffer machinery: diff() is a whole frame while force_full and then
// only the changed runs (one cursor move per run), commit() silences it, and
// resize() reallocates both grids and forces a full repaint.
// Touched-cell tracking marks each write so diff() emits only those cells.

import testing
import term

include "../basalam/basalam.salam"

func rect(x: int, y: int, w: int, h: int): basalam.Rect:
    ret basalam.Rect { x = x, y = y, width = w, height = h }
end

func test_new_is_blank():
    mut b := basalam.NewBuffer(3, 2)
    testing.AssertEqInt(b.cells.len(), 6)
    testing.AssertEqStr(b.row_text(0), "   ")
    testing.AssertEqStr(b.row_text(1), "   ")
    testing.AssertEqInt(b.clip.width, 3)
    testing.AssertEqInt(b.clip.height, 2)
    testing.AssertEqStr(b.get(0, 0).style, "")
    b.free()
    neg := basalam.NewBuffer(-4, 2)
    testing.AssertEqInt(neg.width, 0)
    testing.AssertEqInt(neg.cells.len(), 0)
end

func test_set_get():
    mut b := basalam.NewBuffer(3, 2)
    bold := term.Sgr(term.StyleBold)
    b.set(2, 1, basalam.Cell { ch = "x", style = bold })
    testing.AssertEqStr(b.get(2, 1).ch, "x")
    testing.AssertEqStr(b.get(2, 1).style, bold)
    testing.AssertEqStr(b.row_text(1), "  x")
    b.free()
end

func test_out_of_range_is_noop():
    mut b := basalam.NewBuffer(2, 2)
    b.set(-1, 0, basalam.Cell { ch = "a" })
    b.set(2, 0, basalam.Cell { ch = "b" })
    b.set(0, 2, basalam.Cell { ch = "c" })
    b.set(0, -1, basalam.Cell { ch = "d" })
    testing.AssertEqStr(b.row_text(0), "  ")
    testing.AssertEqStr(b.row_text(1), "  ")
    testing.AssertEqStr(b.get(5, 5).ch, " ")
    testing.AssertEqStr(b.row_text(9), "")
    b.free()
end

func test_clip():
    mut b := basalam.NewBuffer(6, 1)
    mut view := b
    view.clip = rect(1, 0, 3, 1)
    view.put_str(0, 0, "abcdef", "")
    // The view shares the cells, so the original sees what fit in the clip.
    testing.AssertEqStr(b.row_text(0), " bcd  ")
    // The original's own clip is untouched.
    testing.AssertEqInt(b.clip.width, 6)
    b.free()
end

func test_put_str_codepoints():
    mut b := basalam.NewBuffer(6, 1)
    b.put_str(1, 0, "سلام", "")
    testing.AssertEqStr(b.get(1, 0).ch, "س")
    testing.AssertEqStr(b.get(4, 0).ch, "م")
    testing.AssertEqStr(b.get(5, 0).ch, " ")
    b.put_str(4, 0, "xyz", "")
    testing.AssertEqStr(b.get(5, 0).ch, "y")
    b.free()
end

func test_fill_and_clear():
    mut b := basalam.NewBuffer(4, 3)
    b.fill(rect(1, 1, 5, 5), "#", "")
    testing.AssertEqStr(b.row_text(0), "    ")
    testing.AssertEqStr(b.row_text(1), " ###")
    testing.AssertEqStr(b.row_text(2), " ###")
    b.clear()
    testing.AssertEqStr(b.row_text(1), "    ")
    b.free()
end

func test_resize():
    mut b := basalam.NewBuffer(2, 2)
    b.set(0, 0, basalam.Cell { ch = "x", style = term.Sgr(term.StyleBold) })
    b.resize(4, 3)
    testing.AssertEqInt(b.width, 4)
    testing.AssertEqInt(b.height, 3)
    // Fresh blank grid: the pre-resize content is gone.
    testing.AssertEqStr(b.row_text(0), "    ")
    testing.AssertEqStr(b.row_text(2), "    ")
    testing.AssertEqStr(b.row_text(3), "")
    testing.AssertEqStr(b.get(0, 0).ch, " ")
    testing.AssertEqStr(b.get(0, 0).style, "")
    // Storage is width * height: the last cell is addressable, one past is not.
    b.set(3, 2, basalam.Cell { ch = "z" })
    testing.AssertEqStr(b.row_text(2), "   z")
    b.set(4, 2, basalam.Cell { ch = "!" })
    testing.AssertEqStr(b.get(4, 2).ch, " ")
    testing.AssertEqStr(b.get(3, 2).ch, "z")
    // clip covers the whole new grid.
    testing.AssertEqInt(b.clip.width, 4)
    testing.AssertEqInt(b.clip.height, 3)
    // Negative and zero sizes clamp to zero, as in NewBuffer.
    b.resize(-2, 1)
    testing.AssertEqInt(b.width, 0)
    testing.AssertEqInt(b.height, 1)
    testing.AssertEqStr(b.row_text(0), "")
    b.resize(0, 0)
    testing.AssertEqInt(b.width, 0)
    testing.AssertEqInt(b.height, 0)
    testing.AssertEqStr(b.row_text(0), "")
    b.free()
end

func test_ansi_serialization():
    mut b := basalam.NewBuffer(2, 2)
    bold := term.Sgr(term.StyleBold)
    b.set(0, 0, basalam.Cell { ch = "a" })
    b.set(1, 0, basalam.Cell { ch = "b", style = bold })
    b.set(0, 1, basalam.Cell { ch = "c", style = bold })
    b.set(1, 1, basalam.Cell { ch = "d" })
    // The whole grid, never a diff: a cursor move prefixes each row, cells in
    // order, Reset + style only where the style starts, and a trailing Reset.
    want := term.SeqMoveTo(1, 1) + "a" + term.Reset + bold + "b" + term.SeqMoveTo(2, 1) + "c" + term.Reset + "d" + term.Reset
    testing.AssertEqStr(b.ansi(), want)
    b.free()
end

func test_put_str_style():
    mut b := basalam.NewBuffer(3, 1)
    bold := term.Sgr(term.StyleBold)
    b.put_str(0, 0, "abc", bold)
    testing.AssertEqStr(b.get(0, 0).style, bold)
    testing.AssertEqStr(b.get(2, 0).style, bold)
    // row_text exposes the characters only, never the styles.
    testing.AssertEqStr(b.row_text(0), "abc")
    b.free()
end

func test_off_grid_starts():
    mut b := basalam.NewBuffer(3, 2)
    // Negative x: clipping is per codepoint, so the in-grid tail still lands.
    b.put_str(-1, 0, "ab", "")
    testing.AssertEqStr(b.row_text(0), "b  ")
    // Negative y: the whole row start is off-grid, nothing lands.
    b.clear()
    b.put_str(0, -1, "xy", "")
    testing.AssertEqStr(b.row_text(0), "   ")
    // Starts on the right and bottom edges: the first cell is already outside.
    b.put_str(3, 0, "z", "")
    b.put_str(0, 2, "z", "")
    testing.AssertEqStr(b.row_text(0), "   ")
    testing.AssertEqStr(b.row_text(1), "   ")
    b.free()
end

func test_fill_edges():
    mut b := basalam.NewBuffer(2, 2)
    // Rect partly outside the grid: only the in-grid cells are set.
    b.fill(rect(-1, -1, 3, 3), "#", "")
    testing.AssertEqStr(b.row_text(0), "##")
    testing.AssertEqStr(b.row_text(1), "##")
    // A rect starting on the right edge is wholly outside, so it writes nothing.
    b.clear()
    b.fill(rect(2, 0, 1, 1), "#", "")
    testing.AssertEqStr(b.row_text(0), "  ")
    b.free()

    mut c := basalam.NewBuffer(3, 3)
    mut view := c
    view.clip = rect(1, 1, 1, 1)
    // fill is clipped: only the single cell the clip exposes is written.
    view.fill(rect(0, 0, 3, 3), "#", "")
    testing.AssertEqStr(c.row_text(0), "   ")
    testing.AssertEqStr(c.row_text(1), " # ")
    testing.AssertEqStr(c.row_text(2), "   ")
    c.free()
end

func test_clip_vs_grid():
    mut b := basalam.NewBuffer(3, 2)
    mut view := b
    view.clip = rect(1, 0, 1, 1)
    // set: inside the grid but outside clip, so dropped.
    view.set(0, 1, basalam.Cell { ch = "x" })
    testing.AssertEqStr(b.row_text(1), "   ")
    // set inside clip lands, and shared storage shows it to the original.
    view.set(1, 0, basalam.Cell { ch = "y" })
    testing.AssertEqStr(b.row_text(0), " y ")
    // get ignores clip: reads the whole grid through the narrowed view.
    testing.AssertEqStr(view.get(0, 0).ch, " ")
    testing.AssertEqStr(view.get(1, 0).ch, "y")
    // row_text ignores clip too: the full row, not just the clipped cell.
    testing.AssertEqStr(view.row_text(0), " y ")
    // clear ignores clip: wipes every cell of the grid.
    view.clear()
    testing.AssertEqStr(b.row_text(0), "   ")
    testing.AssertEqStr(b.row_text(1), "   ")
    b.free()
end

func test_focused_is_per_copy():
    mut b := basalam.NewBuffer(2, 1)
    mut view := b
    view.focused = true
    testing.AssertTrue(view.focused)
    testing.AssertFalse(b.focused)
    b.free()
end

func test_diff_full_on_new():
    mut b := basalam.NewBuffer(2, 2)
    bold := term.Sgr(term.StyleBold)
    b.set(0, 0, basalam.Cell { ch = "a" })
    b.set(1, 0, basalam.Cell { ch = "b", style = bold })
    b.set(0, 1, basalam.Cell { ch = "c", style = bold })
    b.set(1, 1, basalam.Cell { ch = "d" })
    // A fresh buffer must repaint everything, byte for byte like ansi().
    testing.AssertTrue(b.force_full)
    testing.AssertEqStr(b.diff(), b.ansi())
    b.free()
end

func test_commit_clears_diff():
    mut b := basalam.NewBuffer(2, 1)
    b.set(0, 0, basalam.Cell { ch = "x" })
    b.commit()
    // After a commit the front grid matches the back grid: nothing to draw.
    testing.AssertFalse(b.force_full)
    testing.AssertEqStr(b.diff(), "")
    b.free()
end

func test_diff_single_cell():
    mut b := basalam.NewBuffer(3, 1)
    b.commit()
    b.set(1, 0, basalam.Cell { ch = "x" })
    // One run: a cursor move, the character, and the closing reset.
    want := term.SeqMoveTo(1, 2) + "x" + term.Reset
    testing.AssertEqStr(b.diff(), want)
    b.free()
end

func test_diff_adjacent_run():
    mut b := basalam.NewBuffer(4, 1)
    b.commit()
    b.set(1, 0, basalam.Cell { ch = "a" })
    b.set(2, 0, basalam.Cell { ch = "b" })
    // Adjacent changed cells share one cursor move and one run.
    want := term.SeqMoveTo(1, 2) + "ab" + term.Reset
    testing.AssertEqStr(b.diff(), want)
    b.free()
end

func test_diff_two_runs():
    mut b := basalam.NewBuffer(5, 1)
    b.commit()
    b.set(0, 0, basalam.Cell { ch = "a" })
    b.set(3, 0, basalam.Cell { ch = "b" })
    // A gap between changed cells splits the row into two runs.
    want := term.SeqMoveTo(1, 1) + "a" + term.SeqMoveTo(1, 4) + "b" + term.Reset
    testing.AssertEqStr(b.diff(), want)
    b.free()
end

func test_diff_style_only():
    mut b := basalam.NewBuffer(2, 1)
    bold := term.Sgr(term.StyleBold)
    b.set(0, 0, basalam.Cell { ch = "a" })
    b.commit()
    b.set(0, 0, basalam.Cell { ch = "a", style = bold })
    // Same character, new style: reset into the style, then draw it again.
    want := term.SeqMoveTo(1, 1) + term.Reset + bold + "a" + term.Reset
    testing.AssertEqStr(b.diff(), want)
    b.free()
end

func test_clear_redraw_is_empty():
    mut b := basalam.NewBuffer(3, 1)
    b.put_str(0, 0, "abc", "")
    b.commit()
    // Repainting the same content after a clear leaves nothing to draw.
    b.clear()
    b.put_str(0, 0, "abc", "")
    testing.AssertEqStr(b.diff(), "")
    b.free()
end

func test_resize_forces_full():
    mut b := basalam.NewBuffer(2, 2)
    b.set(0, 0, basalam.Cell { ch = "x" })
    b.commit()
    testing.AssertEqStr(b.diff(), "")
    b.resize(3, 1)
    // A resize reallocates both grids and forces a whole-frame repaint.
    testing.AssertTrue(b.force_full)
    testing.AssertEqInt(b.width, 3)
    testing.AssertEqInt(b.height, 1)
    testing.AssertEqStr(b.row_text(0), "   ")
    testing.AssertEqStr(b.diff(), b.ansi())
    b.free()
end

func test_front_shared_through_copies():
    mut b := basalam.NewBuffer(2, 1)
    b.commit()
    mut view := b
    view.set(0, 0, basalam.Cell { ch = "z" })
    // The copy writes the shared back grid, so the original diffs the change.
    want := term.SeqMoveTo(1, 1) + "z" + term.Reset
    testing.AssertEqStr(b.diff(), want)
    // free() releases both grids once; teardown exercises it here.
    b.free()
end

func test_diff_sparse_rows():
    mut b := basalam.NewBuffer(6, 3)
    b.commit()
    b.set(0, 0, basalam.Cell { ch = "a" })
    b.set(4, 2, basalam.Cell { ch = "b" })
    // Changed cells on different rows are separate runs.
    want := term.SeqMoveTo(1, 1) + "a" + term.SeqMoveTo(3, 5) + "b" + term.Reset
    testing.AssertEqStr(b.diff(), want)
    b.free()
end

func test_diff_identical_write():
    mut b := basalam.NewBuffer(3, 1)
    b.commit()
    // A blank is the default cell, so writing it again is not a change.
    b.set(1, 0, basalam.Cell { ch = " " })
    testing.AssertEqStr(b.diff(), "")
    b.free()
end

func test_clear_round_trip():
    mut b := basalam.NewBuffer(4, 1)
    b.put_str(0, 0, "ab", "")
    b.commit()
    b.clear()
    // Only the two cells that held text differ from the front grid.
    want := term.SeqMoveTo(1, 1) + "  " + term.Reset
    testing.AssertEqStr(b.diff(), want)
    b.commit()
    testing.AssertEqStr(b.diff(), "")
    testing.AssertEqStr(b.row_text(0), "    ")
    b.free()
end

func test_commit_front_matches_cells():
    mut b := basalam.NewBuffer(3, 2)
    bold := term.Sgr(term.StyleBold)
    b.set(0, 0, basalam.Cell { ch = "a" })
    b.set(2, 0, basalam.Cell { ch = "b", style = bold })
    b.set(1, 1, basalam.Cell { ch = "c" })
    b.commit()
    // commit filled front. Read it; nothing here writes it.
    repeat b.cells.len() in i:
        testing.AssertEqStr(b.front.get(i).ch, b.cells.get(i).ch)
        testing.AssertEqStr(b.front.get(i).style, b.cells.get(i).style)
    end
    b.free()
end

func test_diff_outside_clip():
    mut b := basalam.NewBuffer(4, 2)
    b.commit()
    b.clip = rect(1, 0, 2, 1)
    // Inside the grid, outside the clip: set drops it, so diff stays empty.
    b.set(0, 0, basalam.Cell { ch = "x" })
    testing.AssertEqStr(b.diff(), "")
    b.free()
end

func main:
    test_new_is_blank()
    test_set_get()
    test_out_of_range_is_noop()
    test_clip()
    test_put_str_codepoints()
    test_fill_and_clear()
    test_resize()
    test_ansi_serialization()
    test_put_str_style()
    test_off_grid_starts()
    test_fill_edges()
    test_clip_vs_grid()
    test_focused_is_per_copy()
    test_diff_full_on_new()
    test_commit_clears_diff()
    test_diff_single_cell()
    test_diff_adjacent_run()
    test_diff_two_runs()
    test_diff_style_only()
    test_clear_redraw_is_empty()
    test_resize_forces_full()
    test_front_shared_through_copies()
    test_diff_sparse_rows()
    test_diff_identical_write()
    test_clear_round_trip()
    test_commit_front_matches_cells()
    test_diff_outside_clip()
    ret testing.Summary()
end
