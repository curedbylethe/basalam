    g.set_align(ib, basalam.CrossAlign.Center, basalam.CrossAlign.Stretch)
    g.set_bounds(rect(0, 0, 10, 4))
    // cols 5,5; cell0 margin 1 -> {1,1,3,2}; cell1 center of a 2-wide child.
    checkRect(a.bounds(), 1, 1, 3, 2)
    checkRect(b.bounds(), 6, 0, 2, 4)
end

