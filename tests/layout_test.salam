end

func test_pref_container_yields_avail():
    outer := basalam.NewRow()
    innerd := basalam.NewRow() as dyn basalam.Widget
    i := outer.add(innerd)
    outer.set_align(i, basalam.CrossAlign.Stretch, basalam.CrossAlign.Center)
    outer.set_bounds(rect(0, 0, 8, 5))
    // A container cannot measure: the sentinel fills the axis (avail 5).
    checkRect(innerd.bounds(), 0, 0, 8, 5)
end

func test_empty_content():
    col := basalam.NewColumn()
    col.set_padding(basalam.UniformInsets(1))
    a := leaf()
    _ := col.add(a)
    col.set_bounds(rect(0, 0, 0, 0))
    // R12: an empty content box gives every descendant an empty rect.
    checkRect(a.bounds(), 0, 0, 0, 0)
end

func test_slot_bad_index_ignored():
    row := basalam.NewRow()
