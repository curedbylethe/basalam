    g.set_cell(iq, 1, 1)
    g.set_bounds(rect(0, 0, 12, 6))
    // cols 4,4,4; rows 3,3. p cell (0,0), q cell (1,1).
    checkRect(p.bounds(), 0, 0, 4, 3)
    checkRect(q.bounds(), 4, 3, 4, 3)
end

func test_grid_out_of_range():
    g := basalam.NewGrid(2, 2)
    p := leaf()
    i := g.add(p)
    g.set_cell(i, 5, 5)
    g.set_bounds(rect(3, 4, 8, 6))
    // Out of range -> 0x0 at the content origin; the child is still placed.
    checkRect(p.bounds(), 3, 4, 0, 0)
end

func test_stack_overlap():
    st := basalam.NewStack()
    st.set_padding(ins(1, 2, 1, 2))
    a := leaf()
    b := leaf()
    _ := st.add(a)
    ib := st.add(b)
    st.set_margin(ib, ins(1, 3, 2, 4))
    st.set_bounds(rect(0, 0, 30, 10))
    checkRect(a.bounds(), 2, 1, 26, 8)
    checkRect(b.bounds(), 6, 2, 19, 5)
end

func test_pref_cross_axis():
    row := basalam.NewRow()
    ad := basalam.NewText("hi") as dyn basalam.Widget
    i := row.add(ad)
    row.set_width(i, fixedSize(6))
    row.set_align(i, basalam.CrossAlign.Stretch, basalam.CrossAlign.Center)
    row.set_bounds(rect(0, 0, 6, 9))
    // Main x fixed 6 -> box {0,0,6,9}; natural height 1 at width 6;
    // free 8 -> centre 4.
    checkRect(ad.bounds(), 0, 4, 6, 1)
end

func test_pref_end_alignment():
