// ---- AC1: recursive layout tree ------------------------------------------

func test_screen_fit_root_recursion():
    root := basalam.NewColumn()
    root.set_padding(basalam.UniformInsets(1))
    a := leaf()
    mid := basalam.NewRow()
    midd := mid as dyn basalam.Widget
    b := leaf()
    _ := root.add(a)
    _ := root.add(midd)
    _ := root.add(b)

    // A headless screen: NewScreen fits the root to the buffer, and the
    // container override cascades to every registered child.
    scr := basalam.NewScreen(root as dyn basalam.Widget, 20, 10)
    _ := scr.add(basalam.RootId, a)
    _ := scr.add(basalam.RootId, midd)
    _ := scr.add(basalam.RootId, b)
    checkRect(scr.widget(basalam.RootId).bounds(), 0, 0, 20, 10)
    checkRect(a.bounds(), 1, 1, 18, 3)
    checkRect(midd.bounds(), 1, 4, 18, 3)
    checkRect(b.bounds(), 1, 7, 18, 2)

    // resize refits the root and re-lays out: content {1,1,18,10} -> 4,3,3.
    scr.resize(20, 12)
    checkRect(scr.widget(basalam.RootId).bounds(), 0, 0, 20, 12)
    checkRect(a.bounds(), 1, 1, 18, 4)
    checkRect(midd.bounds(), 1, 5, 18, 3)
    checkRect(b.bounds(), 1, 8, 18, 3)
end

func test_deep_column_row_grid_d():
    grid := basalam.NewGrid(2, 3)
    gc := leaf()
    ga := leaf()
    gd := leaf()
    gb := leaf()
    igc := grid.add(gc)
    iga := grid.add(ga)
    igd := grid.add(gd)
    igb := grid.add(gb)
    grid.set_cell(igc, 1, 2)
    grid.set_margin(igc, basalam.UniformInsets(1))
    grid.set_cell(iga, 0, 0)
    grid.set_cell(igd, 1, 0)
    grid.set_width(igd, fixedSize(5))
    grid.set_height(igd, fixedSize(2))
    grid.set_align(igd, basalam.CrossAlign.End, basalam.CrossAlign.Start)
    grid.set_cell(igb, 0, 1)
    grid.set_width(igb, fixedSize(6))
    grid.set_height(igb, fixedSize(3))
    grid.set_align(igb, basalam.CrossAlign.Center, basalam.CrossAlign.Center)
    gridd := grid as dyn basalam.Widget

    row := basalam.NewRow()
    s := leaf()
    is := row.add(s)
    row.set_width(is, fixedSize(15))
    ig := row.add(gridd)
    row.set_margin(ig, basalam.UniformInsets(1))
    rowd := row as dyn basalam.Widget

    root := basalam.NewColumn()
    root.set_padding(basalam.UniformInsets(1))
    h := leaf()
    f := leaf()
    ih := root.add(h)
    root.set_height(ih, fixedSize(3))
    _ := root.add(rowd)
    iff := root.add(f)
    root.set_height(iff, fixedSize(1))
    root.set_bounds(rect(0, 0, 60, 20))

    checkRect(h.bounds(), 1, 1, 58, 3)
    checkRect(rowd.bounds(), 1, 4, 58, 14)
    checkRect(s.bounds(), 1, 4, 15, 14)
    checkRect(gridd.bounds(), 17, 5, 41, 12)
    checkRect(gc.bounds(), 46, 12, 11, 4)
    checkRect(ga.bounds(), 17, 5, 14, 6)
    checkRect(gd.bounds(), 26, 11, 5, 2)
    checkRect(gb.bounds(), 35, 6, 6, 3)
    checkRect(f.bounds(), 1, 18, 58, 1)
end

func test_recursion_empty_not_skipped_g1():
    inner := basalam.NewRow()
    b := leaf()
    _ := inner.add(b)
    innerd := inner as dyn basalam.Widget

    col := basalam.NewColumn()
    col.set_padding(basalam.UniformInsets(1))
    a := leaf()
    _ := col.add(a)
    _ := col.add(innerd)
    // Sentinel bounds: an unvisited leaf would keep them.
    a.set_bounds(rect(9, 9, 9, 9))
    b.set_bounds(rect(9, 9, 9, 9))
    col.set_bounds(rect(0, 0, 0, 0))
    checkEmpty(a.bounds())
    checkEmpty(innerd.bounds())
    checkEmpty(b.bounds())
end

