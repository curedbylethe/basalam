// Unit tests for the layout box arithmetic: FitRect, InsetRect, SplitMain,
// TrackSizes and the two axis-placement helpers. The cases are the spec's
// worked vectors, not a random sweep: the two padding vectors (uniform and
// per-side), the over-budget padding that must collapse to an empty rect
// anchored at the raw origin, a negative inset side that must clamp to 0, the
// three main-axis split vectors, split with no Fill entries and with Fixed
// entries that exceed the length, a negative Fixed that clamps to 0, the grid
// track vectors, and the placement tables for Start/Center/End/Stretch plus
// the non-positive-avail edge (which behaves like Stretch). Rect normal form
// (never a negative dimension) is asserted directly on FitRect.

import testing

include "../basalam/basalam.salam"

func rect(x: int, y: int, w: int, h: int): basalam.Rect:
    ret basalam.Rect { x = x, y = y, width = w, height = h }
end

// Raw insets (negatives preserved) so the clamping in the helpers is the
// thing under test.
func ins(t: int, r: int, b: int, l: int): basalam.Insets:
    ret basalam.Insets { top = t, right = r, bottom = b, left = l }
end

func fillSize(): basalam.LayoutSize:
    ret basalam.LayoutSize { kind = basalam.SizeKind.Fill }
end

func prefSize(): basalam.LayoutSize:
    ret basalam.LayoutSize { kind = basalam.SizeKind.Pref }
end

func fixedSize(n: int): basalam.LayoutSize:
    ret basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = n }
end

func test_inset_uniform():
    r := basalam.InsetRect(rect(0, 0, 80, 24), basalam.UniformInsets(1))
    testing.AssertEqInt(r.x, 1)
    testing.AssertEqInt(r.y, 1)
    testing.AssertEqInt(r.width, 78)
    testing.AssertEqInt(r.height, 22)
end

func test_inset_margin():
    r := basalam.InsetRect(rect(0, 0, 16, 9), ins(1, 2, 1, 2))
    testing.AssertEqInt(r.x, 2)
    testing.AssertEqInt(r.y, 1)
    testing.AssertEqInt(r.width, 12)
    testing.AssertEqInt(r.height, 7)
end

func test_inset_over_budget():
    // raw {6,7,-2,-4} clipped back inside {2,3,6,4} -> 0x0 at (6,7).
    r := basalam.InsetRect(rect(2, 3, 6, 4), basalam.UniformInsets(4))
    testing.AssertEqInt(r.x, 6)
    testing.AssertEqInt(r.y, 7)
    testing.AssertEqInt(r.width, 0)
    testing.AssertEqInt(r.height, 0)
    testing.AssertTrue(r.is_empty())
end

func test_inset_negative():
    // A negative side adds nothing: left -5 clamps to 0.
    r := basalam.InsetRect(rect(0, 0, 10, 5), ins(0, 0, 0, -5))
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 10)
    testing.AssertEqInt(r.height, 5)
    n := basalam.NewInsets(-5, 2, -1, 0)
    testing.AssertEqInt(n.top, 0)
    testing.AssertEqInt(n.right, 2)
    testing.AssertEqInt(n.bottom, 0)
    testing.AssertEqInt(n.left, 0)
end

func test_inset_empty():
    r := basalam.InsetRect(rect(0, 0, 0, 0), basalam.UniformInsets(1))
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 0)
    testing.AssertEqInt(r.height, 0)
end

func test_fit_rect():
    i := basalam.FitRect(rect(0, 0, 4, 4), rect(2, 1, 5, 2))
    testing.AssertEqInt(i.x, 2)
    testing.AssertEqInt(i.y, 1)
    testing.AssertEqInt(i.width, 2)
    testing.AssertEqInt(i.height, 2)
end

func test_fit_rect_empty():
    // Disjoint: 0x0 at the nearest point of the box (10,10).
    e := basalam.FitRect(rect(0, 0, 4, 4), rect(10, 10, 2, 2))
    testing.AssertEqInt(e.x, 10)
    testing.AssertEqInt(e.y, 10)
    testing.AssertEqInt(e.width, 0)
    testing.AssertEqInt(e.height, 0)
    testing.AssertTrue(e.is_empty())
    // A negative-dimension input never leaks a negative result.
    n := basalam.FitRect(rect(0, 0, -3, 4), rect(0, 0, 5, 5))
    testing.AssertEqInt(n.width, 0)
    testing.AssertEqInt(n.height, 0)
    testing.AssertTrue(n.width >= 0 and n.height >= 0)
end

func test_split_equal():
    sizes := Vector {} as Vector<basalam.LayoutSize>
    sizes.push(fillSize())
    sizes.push(fillSize())
    sizes.push(fillSize())
    r := basalam.SplitMain(22, sizes)
    testing.AssertEqInt(r.len(), 3)
    testing.AssertEqInt(r.get(0), 8)
    testing.AssertEqInt(r.get(1), 7)
    testing.AssertEqInt(r.get(2), 7)
    sizes.free()
    r.free()
end

func test_split_fixed():
    sizes := Vector {} as Vector<basalam.LayoutSize>
    sizes.push(fixedSize(10))
    sizes.push(fixedSize(5))
    sizes.push(fillSize())
    sizes.push(fillSize())
    sizes.push(fillSize())
    r := basalam.SplitMain(43, sizes)
    testing.AssertEqInt(r.len(), 5)
    testing.AssertEqInt(r.get(0), 10)
    testing.AssertEqInt(r.get(1), 5)
    testing.AssertEqInt(r.get(2), 10)
    testing.AssertEqInt(r.get(3), 9)
    testing.AssertEqInt(r.get(4), 9)
    sizes.free()
    r.free()
end

func test_split_remainder():
    sizes := Vector {} as Vector<basalam.LayoutSize>
    repeat 5:
        sizes.push(fillSize())
    end
    r := basalam.SplitMain(13, sizes)
    testing.AssertEqInt(r.len(), 5)
    testing.AssertEqInt(r.get(0), 3)
    testing.AssertEqInt(r.get(1), 3)
    testing.AssertEqInt(r.get(2), 3)
    testing.AssertEqInt(r.get(3), 2)
    testing.AssertEqInt(r.get(4), 2)
    sizes.free()
    r.free()
end

func test_split_no_fill():
    // No Fill entries: the leftover stays unused.
    sizes := Vector {} as Vector<basalam.LayoutSize>
    sizes.push(fixedSize(3))
    sizes.push(fixedSize(4))
    r := basalam.SplitMain(20, sizes)
    testing.AssertEqInt(r.len(), 2)
    testing.AssertEqInt(r.get(0), 3)
    testing.AssertEqInt(r.get(1), 4)
    sizes.free()
    r.free()
end

func test_split_over_budget():
    // Fixed 8 exceeds L=5: R = 0, so every Fill gets 0 and Fixed is not shrunk.
    sizes := Vector {} as Vector<basalam.LayoutSize>
    sizes.push(fixedSize(8))
    sizes.push(fillSize())
    r := basalam.SplitMain(5, sizes)
    testing.AssertEqInt(r.get(0), 8)
    testing.AssertEqInt(r.get(1), 0)
    sizes.free()
    r.free()
end

func test_split_negative_fixed():
    // A negative Fixed clamps to 0 and does not reduce R.
    sizes := Vector {} as Vector<basalam.LayoutSize>
    sizes.push(fixedSize(-5))
    sizes.push(fillSize())
    r := basalam.SplitMain(10, sizes)
    testing.AssertEqInt(r.get(0), 0)
    testing.AssertEqInt(r.get(1), 10)
    sizes.free()
    r.free()
end

func test_split_pref_counts_as_fill():
    // On a main axis Pref is reserved and acts as Fill (R8).
    sizes := Vector {} as Vector<basalam.LayoutSize>
    sizes.push(prefSize())
    sizes.push(fillSize())
    r := basalam.SplitMain(21, sizes)
    testing.AssertEqInt(r.get(0), 11)
    testing.AssertEqInt(r.get(1), 10)
    sizes.free()
    r.free()
end

func test_split_empty():
    empty := Vector {} as Vector<basalam.LayoutSize>
    r := basalam.SplitMain(10, empty)
    testing.AssertEqInt(r.len(), 0)
    empty.free()
    r.free()
    one := Vector {} as Vector<basalam.LayoutSize>
    one.push(fillSize())
    z := basalam.SplitMain(0, one)
    testing.AssertEqInt(z.len(), 1)
    testing.AssertEqInt(z.get(0), 0)
    one.free()
    z.free()
end

func test_tracks_uneven():
    r := basalam.TrackSizes(41, 3)
    testing.AssertEqInt(r.len(), 3)
    testing.AssertEqInt(r.get(0), 14)
    testing.AssertEqInt(r.get(1), 14)
    testing.AssertEqInt(r.get(2), 13)
    r.free()
end

func test_tracks_even():
    r := basalam.TrackSizes(12, 2)
    testing.AssertEqInt(r.get(0), 6)
    testing.AssertEqInt(r.get(1), 6)
    r.free()
end

func test_tracks_zero():
    z := basalam.TrackSizes(0, 3)
    testing.AssertEqInt(z.len(), 3)
    testing.AssertEqInt(z.get(0), 0)
    testing.AssertEqInt(z.get(1), 0)
    testing.AssertEqInt(z.get(2), 0)
    z.free()
    n := basalam.TrackSizes(5, 0)
    testing.AssertEqInt(n.len(), 0)
    n.free()
    nn := basalam.TrackSizes(0, 0)
    testing.AssertEqInt(nn.len(), 0)
    nn.free()
end

func test_place_center_table():
    // avail 10, free 0..5 -> offset 0,0,1,1,2,2; the odd cell trails.
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 10), 0)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 9), 0)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 8), 1)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 7), 1)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 6), 2)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 5), 2)
    // Size is the natural size on a non-Stretch axis.
    testing.AssertEqInt(basalam.PlaceAxisSize(10, basalam.CrossAlign.Center, 5), 5)
end

func test_place_start_end_stretch():
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Start, 4), 0)
    testing.AssertEqInt(basalam.PlaceAxisSize(10, basalam.CrossAlign.Start, 4), 4)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.End, 4), 6)
    testing.AssertEqInt(basalam.PlaceAxisSize(10, basalam.CrossAlign.End, 4), 4)
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Center, 4), 3)
    testing.AssertEqInt(basalam.PlaceAxisSize(10, basalam.CrossAlign.Center, 4), 4)
    // Stretch ignores the natural size and fills the axis.
    testing.AssertEqInt(basalam.PlaceAxisOffset(10, basalam.CrossAlign.Stretch, 99), 0)
    testing.AssertEqInt(basalam.PlaceAxisSize(10, basalam.CrossAlign.Stretch, 99), 10)
end

func test_place_clamp():
    // natural above avail clamps down; below 0 clamps up.
    testing.AssertEqInt(basalam.PlaceAxisSize(5, basalam.CrossAlign.End, 9), 5)
    testing.AssertEqInt(basalam.PlaceAxisOffset(5, basalam.CrossAlign.End, 9), 0)
    testing.AssertEqInt(basalam.PlaceAxisSize(5, basalam.CrossAlign.End, -2), 0)
    testing.AssertEqInt(basalam.PlaceAxisOffset(5, basalam.CrossAlign.End, -2), 5)
end

func test_place_nonpositive():
    // avail <= 0 behaves like Stretch: offset 0, size max(0, avail).
    testing.AssertEqInt(basalam.PlaceAxisOffset(0, basalam.CrossAlign.Center, 3), 0)
    testing.AssertEqInt(basalam.PlaceAxisSize(0, basalam.CrossAlign.Center, 3), 0)
    testing.AssertEqInt(basalam.PlaceAxisOffset(-3, basalam.CrossAlign.Start, 3), 0)
    testing.AssertEqInt(basalam.PlaceAxisSize(-3, basalam.CrossAlign.Start, 3), 0)
    testing.AssertEqInt(basalam.PlaceAxisOffset(-3, basalam.CrossAlign.Stretch, 3), 0)
    testing.AssertEqInt(basalam.PlaceAxisSize(-3, basalam.CrossAlign.Stretch, 3), 0)
end

func main:
    test_inset_uniform()
    test_inset_margin()
    test_inset_over_budget()
    test_inset_negative()
    test_inset_empty()
    test_fit_rect()
    test_fit_rect_empty()
    test_split_equal()
    test_split_fixed()
    test_split_remainder()
    test_split_no_fill()
    test_split_over_budget()
    test_split_negative_fixed()
    test_split_pref_counts_as_fill()
    test_split_empty()
    test_tracks_uneven()
    test_tracks_even()
    test_tracks_zero()
    test_place_center_table()
    test_place_start_end_stretch()
    test_place_clamp()
    test_place_nonpositive()
    ret testing.Summary()
end
