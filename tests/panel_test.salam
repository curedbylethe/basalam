// Unit tests for the Panel decorator: the frame it paints per BorderStyle,
// title present / blank / truncated, the None pass-through, the child inset
// by BorderInset on set_bounds, resize re-insetting, a degenerate one-row
// panel, the attribute-free border_style, add replacing the child, a Column
// child being positioned inside the frame, and the preferred size it reports:
// the child's size plus the ring, the max_width forwarded to the child, the
// per-axis sentinel, and the empty slot. Expected SGR strings come from
// basalam.StyleSgr, so no escape appears by hand.

import term
import testing

include "../basalam/basalam.salam"

// A child that records nothing and paints nothing; the tests read its rect
// back through the Panel's slot.
struct Probe:
    pub use basalam.BaseWidget
end

// A child that consumes the key "k" and passes everything else on.
struct Keyed:
    pub use basalam.BaseWidget

    pub func handle_event(event: basalam.Event): bool:
        ret event.is_char("k")
    end
end

// A child that reports a fixed preferred size. A non-negative expect asserts
// the max_width the Panel forwarded, so the forwarding rule is observable
// without recording state.
struct FixedSizer:
    pub use basalam.BaseWidget

    pub w: int = 0
    pub h: int = 0
    pub expect: int = -1

    pub func preferred_size(max_width: int): basalam.Rect:
        if this.expect >= 0:
            testing.AssertEqInt(max_width, this.expect)
        end
        ret basalam.Rect { width = this.w, height = this.h }
    end
end

func test_single_frame_painted():
    mut b := basalam.NewBuffer(8, 3)
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 8, height = 3 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.row_text(0), "┌──────┐")
    testing.AssertEqStr(b.row_text(1), "│      │")
    testing.AssertEqStr(b.row_text(2), "└──────┘")
    b.free()
end

func test_double_and_rounded_glyphs():
    mut d := basalam.NewBuffer(4, 3)
    mut dp := basalam.Panel { border = basalam.BorderStyle.Double }
    dp.add(Probe {})
    dr := basalam.Rect { x = 0, y = 0, width = 4, height = 3 }
    dp.set_bounds(dr)
    dp.render(d, dr)
    testing.AssertEqStr(d.row_text(0), "╔══╗")
    testing.AssertEqStr(d.row_text(2), "╚══╝")
    d.free()

    mut rb := basalam.NewBuffer(4, 3)
    mut rp := basalam.Panel { border = basalam.BorderStyle.Rounded }
    rp.add(Probe {})
    rp.set_bounds(dr)
    rp.render(rb, dr)
    testing.AssertEqStr(rb.row_text(0), "╭──╮")
    testing.AssertEqStr(rb.row_text(2), "╰──╯")
    rb.free()
end

func test_title_present():
    mut b := basalam.NewBuffer(10, 2)
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, title = "Files" }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 10, height = 2 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.row_text(0), "┌─ Files ┐")
    b.free()
end

func test_title_blank_is_absent():
    mut b := basalam.NewBuffer(10, 2)
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, title = "   " }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 10, height = 2 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.row_text(0), "┌────────┐")
    b.free()
end

func test_title_truncated():
    mut b := basalam.NewBuffer(10, 2)
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, title = "Playback" }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 10, height = 2 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.row_text(0), "┌─ Playb ┐")
    b.free()
end

func test_none_pass_through():
    mut b := basalam.NewBuffer(8, 3)
    b.fill(basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, "x", "")
    mut p := basalam.Panel { title = "Files" }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 8, height = 3 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.row_text(0), "xxxxxxxx")
    testing.AssertEqStr(b.row_text(2), "xxxxxxxx")
    child := p.slot.get(0).child.bounds()
    testing.AssertEqInt(child.x, 0)
    testing.AssertEqInt(child.y, 0)
    testing.AssertEqInt(child.width, 8)
    testing.AssertEqInt(child.height, 3)
    b.free()
end

func test_child_inset_by_single():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(Probe {})
    p.set_bounds(basalam.Rect { x = 2, y = 1, width = 10, height = 6 })
    child := p.slot.get(0).child.bounds()
    testing.AssertEqInt(child.x, 3)
    testing.AssertEqInt(child.y, 2)
    testing.AssertEqInt(child.width, 8)
    testing.AssertEqInt(child.height, 4)
end

func test_resize_reinsets():
    mut p := basalam.Panel { border = basalam.BorderStyle.Double }
    p.add(Probe {})
    p.set_bounds(basalam.Rect { x = 0, y = 0, width = 10, height = 6 })
    p.set_bounds(basalam.Rect { x = 0, y = 0, width = 20, height = 10 })
    child := p.slot.get(0).child.bounds()
    testing.AssertEqInt(child.width, 18)
    testing.AssertEqInt(child.height, 8)
end

func test_degenerate_one_row_is_rule():
    mut b := basalam.NewBuffer(10, 1)
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, title = "Files" }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 10, height = 1 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.row_text(0), "──────────")
    b.free()
end

func test_border_style_fg_only():
    mut b := basalam.NewBuffer(8, 3)
    style := basalam.Style { fg = basalam.Color.Ansi(2), bold = true, underline = true }
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, border_style = style, title = "Files" }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 8, height = 3 }
    p.set_bounds(r)
    p.render(b, r)
    want := basalam.StyleSgr(basalam.Style { fg = basalam.Color.Ansi(2) }, basalam.ColorTier.TrueColor)
    testing.AssertEqStr(b.get(0, 0).style, want)
    testing.AssertEqStr(b.get(3, 0).style, want)
    testing.AssertEqStr(b.get(7, 2).style, want)
    b.free()
end

func test_add_replaces_child():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(Probe {})
    p.add(Probe {})
    testing.AssertEqInt(p.slot.len(), 1)
end

func test_column_child_positioned_inside_frame():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(basalam.Column {})
    p.set_bounds(basalam.Rect { x = 0, y = 0, width = 12, height = 5 })
    child := p.slot.get(0).child.bounds()
    testing.AssertEqInt(child.x, 1)
    testing.AssertEqInt(child.y, 1)
    testing.AssertEqInt(child.width, 10)
    testing.AssertEqInt(child.height, 3)
end

func test_preferred_size_adds_frame():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(FixedSizer { w = 4, h = 2 })
    r := p.preferred_size(80)
    testing.AssertEqInt(r.x, 0)
    testing.AssertEqInt(r.y, 0)
    testing.AssertEqInt(r.width, 6)
    testing.AssertEqInt(r.height, 4)
end

func test_preferred_size_fits_requested_width():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(FixedSizer { w = 4, h = 2, expect = 4 })
    r := p.preferred_size(6)
    testing.AssertEqInt(r.width, 6)
    testing.AssertEqInt(r.height, 4)
end

func test_preferred_size_floors_forwarded_width():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(FixedSizer { w = 4, h = 2, expect = 1 })
    r := p.preferred_size(2)
    testing.AssertEqInt(r.width, 6)
    testing.AssertEqInt(r.height, 4)
end

func test_preferred_size_forwards_unbounded():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(FixedSizer { w = 4, h = 2, expect = 0 })
    r := p.preferred_size(0)
    testing.AssertEqInt(r.width, 6)
    testing.AssertEqInt(r.height, 4)
end

func test_preferred_size_keeps_axis_sentinel():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(FixedSizer { w = -1, h = 1 })
    r := p.preferred_size(80)
    testing.AssertEqInt(r.width, -1)
    testing.AssertEqInt(r.height, 3)
end

func test_preferred_size_unmeasurable_child():
    mut p := basalam.Panel { border = basalam.BorderStyle.Single }
    p.add(FixedSizer { w = -1, h = -1 })
    r := p.preferred_size(80)
    testing.AssertEqInt(r.width, -1)
    testing.AssertEqInt(r.height, -1)
end

func test_preferred_size_none_is_identity():
    mut p := basalam.Panel {}
    p.add(FixedSizer { w = 4, h = 2, expect = 80 })
    r := p.preferred_size(80)
    testing.AssertEqInt(r.width, 4)
    testing.AssertEqInt(r.height, 2)
end

func test_preferred_size_empty_slot():
    p := basalam.Panel { border = basalam.BorderStyle.Single }
    r := p.preferred_size(80)
    testing.AssertEqInt(r.width, -1)
    testing.AssertEqInt(r.height, -1)
end

func test_focusable_only_when_opted_in():
    mut off := basalam.Panel {}
    testing.AssertFalse(off.focusable())
    mut focusable_on := basalam.Panel { takes_focus = true }
    testing.AssertTrue(focusable_on.focusable())
end

func test_focus_forwards_keys_to_child():
    mut p := basalam.Panel { takes_focus = true }
    p.add(Keyed {})
    testing.AssertTrue(p.handle_event(basalam.Event { kind = basalam.KeyEvent, key = term.Decode("k") }))
    testing.AssertFalse(p.handle_event(basalam.Event { kind = basalam.KeyEvent, key = term.Decode("x") }))
end

func test_focused_frame_uses_focus_style():
    mut b := basalam.NewBuffer(8, 3)
    b.focused = true
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, border_style = basalam.Style { fg = basalam.Color.Ansi(4) }, focus_style = basalam.Style { fg = basalam.Color.Ansi(3) } }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 8, height = 3 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.get(0, 0).style, basalam.StyleSgr(basalam.Style { fg = basalam.Color.Ansi(3) }, basalam.ColorTier.TrueColor))
    b.free()
end

func test_unfocused_frame_uses_border_style():
    mut b := basalam.NewBuffer(8, 3)
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, border_style = basalam.Style { fg = basalam.Color.Ansi(4) }, focus_style = basalam.Style { fg = basalam.Color.Ansi(3) } }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 8, height = 3 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.get(0, 0).style, basalam.StyleSgr(basalam.Style { fg = basalam.Color.Ansi(4) }, basalam.ColorTier.TrueColor))
    b.free()
end

func test_default_focus_style_keeps_border_style():
    mut b := basalam.NewBuffer(8, 3)
    b.focused = true
    mut p := basalam.Panel { border = basalam.BorderStyle.Single, border_style = basalam.Style { fg = basalam.Color.Ansi(4) } }
    p.add(Probe {})
    r := basalam.Rect { x = 0, y = 0, width = 8, height = 3 }
    p.set_bounds(r)
    p.render(b, r)
    testing.AssertEqStr(b.get(0, 0).style, basalam.StyleSgr(basalam.Style { fg = basalam.Color.Ansi(4) }, basalam.ColorTier.TrueColor))
    b.free()
end

func main:
    test_focusable_only_when_opted_in()
    test_focus_forwards_keys_to_child()
    test_focused_frame_uses_focus_style()
    test_unfocused_frame_uses_border_style()
    test_default_focus_style_keeps_border_style()
    test_single_frame_painted()
    test_double_and_rounded_glyphs()
    test_title_present()
    test_title_blank_is_absent()
    test_title_truncated()
    test_none_pass_through()
    test_child_inset_by_single()
    test_resize_reinsets()
    test_degenerate_one_row_is_rule()
    test_border_style_fg_only()
    test_add_replaces_child()
    test_column_child_positioned_inside_frame()
    test_preferred_size_adds_frame()
    test_preferred_size_fits_requested_width()
    test_preferred_size_floors_forwarded_width()
    test_preferred_size_forwards_unbounded()
    test_preferred_size_keeps_axis_sentinel()
    test_preferred_size_unmeasurable_child()
    test_preferred_size_none_is_identity()
    test_preferred_size_empty_slot()
    ret testing.Summary()
end
