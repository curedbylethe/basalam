func test_empty_rects_write_nothing():
    mut b := basalam.NewBuffer(4, 2)
    b.fill(basalam.Rect { x = 0, y = 0, width = 4, height = 2 }, "x", basalam.StyleDefault)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 0, height = 2 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 2, height = 0 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = -1, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "xxxx")
    testing.AssertEqStr(b.row_text(1), "xxxx")
    b.free()
end

func test_clip_never_shifts():
    mut b := basalam.NewBuffer(10, 3)
    basalam.DrawBorder(b, basalam.Rect { x = 6, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "      ┌───")
    testing.AssertEqStr(b.row_text(1), "      │   ")
    testing.AssertEqStr(b.row_text(2), "      └───")
    b.free()
end

func test_color_is_fg_only():
    mut b := basalam.NewBuffer(8, 3)
    style := basalam.Style { fg = basalam.Color.Ansi(1), bold = true, italic = true }
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Single, style, "Title")
    // The cell carries the foreground as a Style; the attributes are dropped.
    want := basalam.Style { fg = basalam.Color.Ansi(1) }
    testing.AssertTrue(basalam.StyleEq(b.get(0, 0).style, want))
    testing.AssertTrue(basalam.StyleEq(b.get(3, 0).style, want))
    testing.AssertTrue(basalam.StyleEq(b.get(7, 2).style, want))
    b.free()
end

func test_default_fg_writes_no_style():
    mut b := basalam.NewBuffer(8, 3)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertTrue(basalam.StyleEq(b.get(0, 0).style, basalam.StyleDefault))
    b.free()
end

// DrawBorder has no tier parameter; the cells carry the Style
// and the buffer lowers it at emission, like every other styled cell.
func test_tier_lowers_frame_color():
    mut b := basalam.NewBuffer(4, 3)
    defer b.free()
    b.tier = basalam.ColorTier.Ansi16
    style := basalam.Style { fg = basalam.Color.Rgb(255, 0, 0) }
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 4, height = 3 }, basalam.BorderStyle.Single, style, "")
    testing.AssertTrue(basalam.StyleEq(b.get(0, 0).style, style))
    testing.AssertTrue(basalam.StyleEq(b.get(3, 0).style, style))
    testing.AssertTrue(basalam.StyleEq(b.get(0, 2).style, style))
    seq_on := basalam.StyleSgr(style, basalam.ColorTier.Ansi16)
    seq_off := basalam.StyleSgrOff(style, basalam.ColorTier.Ansi16)
    // The ring is not a filled row: the interior cells are default, so the
    // middle row leaves the colour and re-enters it.
    want := term.SeqMoveTo(1, 1) + seq_on + "┌──┐" + term.SeqMoveTo(2, 1) + "│" + seq_off + "  " + seq_on + "│" + term.SeqMoveTo(3, 1) + "└──┘" + seq_off
    testing.AssertEqStr(b.ansi(), want)
    testing.AssertTrue(seq_on != basalam.StyleSgr(style, basalam.ColorTier.TrueColor))
end

func test_tier_off_drops_frame_color_keeps_shape():
    mut b := basalam.NewBuffer(4, 3)
    defer b.free()
    b.tier = basalam.ColorTier.Off
    style := basalam.Style { fg = basalam.Color.Rgb(255, 0, 0) }
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 4, height = 3 }, basalam.BorderStyle.Single, style, "")
    testing.AssertTrue(basalam.StyleEq(b.get(0, 0).style, style))
    testing.AssertTrue(basalam.StyleEq(b.get(1, 1).style, basalam.StyleDefault))
    testing.AssertEqStr(b.row_text(0), "┌──┐")
    testing.AssertEqStr(b.row_text(1), "│  │")
    testing.AssertEqStr(b.row_text(2), "└──┘")
    // At Off every colour lowers to Default, so the frame is glyphs only.
    want := term.SeqMoveTo(1, 1) + "┌──┐" + term.SeqMoveTo(2, 1) + "│  │" + term.SeqMoveTo(3, 1) + "└──┘"
    testing.AssertEqStr(b.ansi(), want)
end

func test_tier_never_changes_glyphs():
    // Same rect at every tier: only the SGR changes, never the shape.
    mut full := basalam.NewBuffer(4, 3)
    defer full.free()
    mut low := basalam.NewBuffer(4, 3)
    defer low.free()
    low.tier = basalam.ColorTier.Ansi16
    mut off := basalam.NewBuffer(4, 3)
    defer off.free()
    off.tier = basalam.ColorTier.Off
    style := basalam.Style { fg = basalam.Color.Rgb(255, 0, 0) }
    basalam.DrawBorder(full, basalam.Rect { x = 0, y = 0, width = 4, height = 3 }, basalam.BorderStyle.Single, style, "")
    basalam.DrawBorder(low, basalam.Rect { x = 0, y = 0, width = 4, height = 3 }, basalam.BorderStyle.Single, style, "")
    basalam.DrawBorder(off, basalam.Rect { x = 0, y = 0, width = 4, height = 3 }, basalam.BorderStyle.Single, style, "")
    repeat 3 in y:
        testing.AssertEqStr(low.row_text(y), full.row_text(y))
        testing.AssertEqStr(off.row_text(y), full.row_text(y))
    end
end

// One ring of `g` in a 6x3 buffer, rows joined by "|" for a compact compare.
func ring(g: basalam.BorderGlyphs, policy: basalam.GlyphPolicy): str:
    mut b := basalam.NewBuffer(6, 3)
    b.glyphs = policy
    basalam.DrawBorderGlyphs(b, basalam.Rect { x = 0, y = 0, width = 6, height = 3 }, g, basalam.Style {}, "")
    out := b.row_text(0) + "/" + b.row_text(1) + "/" + b.row_text(2)
    b.free()
    ret out
end

func test_glyph_set_rings():
    u := basalam.GlyphPolicy.Unicode
    testing.AssertEqStr(ring(basalam.GlyphsSingle(), u), "┌────┐/│    │/└────┘")
    testing.AssertEqStr(ring(basalam.GlyphsDouble(), u), "╔════╗/║    ║/╚════╝")
    testing.AssertEqStr(ring(basalam.GlyphsRounded(), u), "╭────╮/│    │/╰────╯")
    testing.AssertEqStr(ring(basalam.GlyphsASCII(), u), "+----+/|    |/+----+")
    testing.AssertEqStr(ring(basalam.GlyphsHeavy(), u), "┏━━━━┓/┃    ┃/┗━━━━┛")
    testing.AssertEqStr(ring(basalam.GlyphsMixed(), u), "┍━━━━┑/│    │/┕━━━━┙")
end

func joined(g: basalam.BorderGlyphs): str:
    ret g.t_down + g.t_up + g.t_right + g.t_left + g.cross
end

func test_glyph_set_junctions_and_weights():
    testing.AssertEqStr(joined(basalam.GlyphsSingle()), "┬┴├┤┼")
    testing.AssertEqStr(joined(basalam.GlyphsDouble()), "╦╩╠╣╬")
    testing.AssertEqStr(joined(basalam.GlyphsRounded()), "┬┴├┤┼")
    testing.AssertEqStr(joined(basalam.GlyphsASCII()), "+++++")
    testing.AssertEqStr(joined(basalam.GlyphsHeavy()), "┳┻┣┫╋")
    testing.AssertEqStr(joined(basalam.GlyphsMixed()), "┯┷┝┥┿")
    testing.AssertTrue(basalam.GlyphsSingle().hw == basalam.Weight.Light and basalam.GlyphsSingle().vw == basalam.Weight.Light)
    testing.AssertTrue(basalam.GlyphsRounded().hw == basalam.Weight.Light and basalam.GlyphsASCII().vw == basalam.Weight.Light)
    testing.AssertTrue(basalam.GlyphsDouble().hw == basalam.Weight.Double and basalam.GlyphsDouble().vw == basalam.Weight.Double)
    testing.AssertTrue(basalam.GlyphsHeavy().hw == basalam.Weight.Heavy and basalam.GlyphsHeavy().vw == basalam.Weight.Heavy)
    testing.AssertTrue(basalam.GlyphsMixed().hw == basalam.Weight.Heavy and basalam.GlyphsMixed().vw == basalam.Weight.Light)
end

func test_glyphs_for_selects_by_style_and_policy():
    u := basalam.GlyphPolicy.Unicode
    a := basalam.GlyphPolicy.ASCII
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.Single, u).tl, "┌")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.Double, u).tl, "╔")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.Rounded, u).tl, "╭")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.None, u).tl, "")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.None, a).h, "")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.Single, a).tl, "+")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.Double, a).h, "-")
    testing.AssertEqStr(basalam.GlyphsFor(basalam.BorderStyle.Rounded, a).v, "|")
end

func test_border_inset_unchanged():
    testing.AssertEqInt(basalam.BorderInset(basalam.BorderStyle.None), 0)
    testing.AssertEqInt(basalam.BorderInset(basalam.BorderStyle.Single), 1)
    testing.AssertEqInt(basalam.BorderInset(basalam.BorderStyle.Double), 1)
    testing.AssertEqInt(basalam.BorderInset(basalam.BorderStyle.Rounded), 1)
end

func test_custom_glyphs_through_draw_border_glyphs():
    g := basalam.BorderGlyphs { h = "~", v = "!", tl = "1", tr = "2", bl = "3", br = "4" }
    testing.AssertEqStr(ring(g, basalam.GlyphPolicy.Unicode), "1~~~~2/!    !/3~~~~4")
end

func test_ascii_policy_overrides_every_style_and_custom_set():
    a := basalam.GlyphPolicy.ASCII
    want := "+----+/|    |/+----+"
    custom := basalam.BorderGlyphs { h = "~", v = "!", tl = "1", tr = "2", bl = "3", br = "4" }
    testing.AssertEqStr(ring(custom, a), want)
    testing.AssertEqStr(ring(basalam.GlyphsHeavy(), a), want)
    mut styles := Vector {} as Vector<basalam.BorderStyle>
    styles.push(basalam.BorderStyle.Single)
    styles.push(basalam.BorderStyle.Double)
    styles.push(basalam.BorderStyle.Rounded)
    repeat styles.len() in i:
        mut b := basalam.NewBuffer(6, 3)
        b.glyphs = a
        basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 6, height = 3 }, styles.get(i), basalam.Style {}, "")
        testing.AssertEqStr(b.row_text(0), "+----+")
        testing.AssertEqStr(b.row_text(1), "|    |")
        testing.AssertEqStr(b.row_text(2), "+----+")
        b.free()
    end
end

func test_ascii_policy_title_and_degenerate_rects():
    mut b := basalam.NewBuffer(10, 2)
    b.glyphs = basalam.GlyphPolicy.ASCII
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 10, height = 2 }, basalam.BorderStyle.Double, basalam.Style {}, "Hi")
    testing.AssertEqStr(b.row_text(0), "+- Hi ---+")
    testing.AssertEqStr(b.row_text(1), "+--------+")
    b.free()
    mut h := basalam.NewBuffer(5, 1)
    h.glyphs = basalam.GlyphPolicy.ASCII
    basalam.DrawBorder(h, basalam.Rect { x = 0, y = 0, width = 5, height = 1 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertEqStr(h.row_text(0), "-----")
    h.free()
    mut v := basalam.NewBuffer(1, 3)
    v.glyphs = basalam.GlyphPolicy.ASCII
    basalam.DrawBorder(v, basalam.Rect { x = 0, y = 0, width = 1, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertEqStr(v.row_text(0) + v.row_text(1) + v.row_text(2), "|||")
    v.free()
end

func test_detect_glyph_policy_precedence():
    env.Unset("BASALAM_GLYPHS")
    env.Unset("LC_ALL")
    env.Unset("LC_CTYPE")
    env.Unset("LANG")
    env.Set("TERM", "xterm")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.Unicode)
    env.Set("BASALAM_GLYPHS", "ascii")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.ASCII)
    env.Set("TERM", "dumb")
    env.Set("BASALAM_GLYPHS", "unicode")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.Unicode)
    env.Unset("BASALAM_GLYPHS")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.ASCII)
    env.Set("TERM", "xterm")
    env.Set("LANG", "C")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.ASCII)
    env.Set("LANG", "en_US.UTF-8")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.Unicode)
    env.Set("LC_ALL", "POSIX")
    testing.AssertTrue(basalam.DetectGlyphPolicy() == basalam.GlyphPolicy.ASCII)
    env.Unset("LC_ALL")
    env.Unset("LANG")
end

func test_buffer_glyphs_default_and_copy():
    mut b := basalam.NewBuffer(2, 2)
    testing.AssertTrue(b.glyphs == basalam.GlyphPolicy.Unicode)
    b.glyphs = basalam.GlyphPolicy.ASCII
    c := b
    testing.AssertTrue(c.glyphs == basalam.GlyphPolicy.ASCII)
    b.resize(3, 3)
    testing.AssertTrue(b.glyphs == basalam.GlyphPolicy.ASCII)
    b.free()
end

func main:
    test_single_box()
    test_double_box()
    test_rounded_box()
    test_single_writes_eighteen_cells()
    test_none_is_noop()
    test_interior_untouched()
    test_title_exact_fit()
    test_title_truncates_right()
    test_title_truncates_long_name()
    test_title_clips_on_cells()
    test_title_one_char_at_minimum_width()
    test_title_dropped_below_minimum_width()
    test_title_blank_is_absent()
    test_title_trimmed()
    test_height_one_is_horizontal_rule()
    test_one_by_one_is_horizontal_glyph()
    test_width_one_is_vertical_rule()
    test_two_by_two_has_corners_only()
    test_two_by_three_has_vertical_edges()
    test_three_by_two_has_horizontal_edges()
    test_empty_rects_write_nothing()
    test_clip_never_shifts()
    test_color_is_fg_only()
    test_default_fg_writes_no_style()
    test_tier_lowers_frame_color()
    test_tier_off_drops_frame_color_keeps_shape()
    test_tier_never_changes_glyphs()
    test_glyph_set_rings()
    test_glyph_set_junctions_and_weights()
    test_glyphs_for_selects_by_style_and_policy()
    test_border_inset_unchanged()
    test_custom_glyphs_through_draw_border_glyphs()
    test_ascii_policy_overrides_every_style_and_custom_set()
    test_ascii_policy_title_and_degenerate_rects()
    test_detect_glyph_policy_precedence()
    test_buffer_glyphs_default_and_copy()
    ret testing.Summary()
end
