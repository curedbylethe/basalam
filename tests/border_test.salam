// Unit tests for DrawBorder: the glyph tables of each BorderStyle, the title
// vectors (trim, right truncation, minimum width), the degenerate rect rules,
// clipping at the grid edge, the untouched interior, and the one-foreground
// color rule. Expected SGR strings are built with basalam.StyleSgr, so no
// escape appears by hand. Also the colour tier: a buffer pinned to Ansi16 or
// Off lowers the frame's colour without changing its glyphs. Also the six
// glyph sets, GlyphsFor, DrawBorderGlyphs, and the ASCII glyph policy.

import env
import term
import testing

include "../basalam/basalam.salam"

func test_single_box():
    mut b := basalam.NewBuffer(8, 3)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "┌──────┐")
    testing.AssertEqStr(b.row_text(1), "│      │")
    testing.AssertEqStr(b.row_text(2), "└──────┘")
    b.free()
end

func test_double_box():
    mut b := basalam.NewBuffer(8, 3)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Double, basalam.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "╔══════╗")
    testing.AssertEqStr(b.row_text(1), "║      ║")
    testing.AssertEqStr(b.row_text(2), "╚══════╝")
    b.free()
end

func test_rounded_box():
    mut b := basalam.NewBuffer(8, 3)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Rounded, basalam.Style {}, "")
    testing.AssertEqStr(b.row_text(0), "╭──────╮")
    testing.AssertEqStr(b.row_text(1), "│      │")
    testing.AssertEqStr(b.row_text(2), "╰──────╯")
    b.free()
end

func test_single_writes_eighteen_cells():
    mut b := basalam.NewBuffer(8, 3)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    mut drawn := 0
    repeat 3 in y:
        repeat 8 in x:
            if b.get(x, y).ch != " ":
                drawn = drawn + 1
            end
        end
    end
    testing.AssertEqInt(drawn, 18)
    b.free()
end

func test_none_is_noop():
    mut b := basalam.NewBuffer(8, 3)
    b.fill(basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, "x", basalam.StyleDefault)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.None, basalam.Style {}, "Title")
    testing.AssertEqStr(b.row_text(0), "xxxxxxxx")
    testing.AssertEqStr(b.row_text(2), "xxxxxxxx")
    b.free()
end

func test_interior_untouched():
    mut b := basalam.NewBuffer(8, 3)
    b.fill(basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, "x", basalam.StyleDefault)
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 8, height = 3 }, basalam.BorderStyle.Single, basalam.Style {}, "")
    testing.AssertEqStr(b.row_text(1), "│xxxxxx│")
    b.free()
end

