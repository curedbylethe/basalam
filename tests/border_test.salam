func test_title_clips_on_cells():
    mut b := basalam.NewBuffer(10, 2)
    defer b.free()
    basalam.DrawBorder(b, basalam.Rect { x = 0, y = 0, width = 10, height = 2 }, basalam.BorderStyle.Single, basalam.Style {}, "标题长")
    testing.AssertEqStr(b.row_text(0), "┌─ 标题 ─┐")
    testing.AssertEqInt(b.width, 10)
    testing.AssertEqStr(b.get(9, 0).ch, "┐")
end

