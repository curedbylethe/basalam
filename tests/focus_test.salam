// Tests for the focus system: the spatial search (Nearest) on
// plain rects, including the overlap rule and every tie-break, then the
// screen's focus stack, linear order, spatial moves, auto-focus, dispatch
// to the focused widget (with an empty stack it starts at the root, and a
// pushed widget takes the keys until it is popped), and the focus
// indicator reaching the buffer.

import testing
import term

include "../basalam/basalam.salam"

// Records the name of every Tile that receives an event, so the dispatch
// tests can assert the exact visiting order.
mut visits := Vector {} as Vector<str>

// A focusable tile that shows "*" when it has focus and counts the keys it
// consumes ("k").
struct Tile:
    pub use basalam.BaseWidget
    pub name: str = ""
    // Not named hits: that is the Widget method. This counts consumed keys.
    pub keys: int = 0

    pub func focusable(): bool:
        ret true
    end

    pub func handle_event(event: basalam.Event): bool:
        visits.push(this.name)
        if event.is_char("k"):
            this.keys += 1
            ret true
        end
        ret false
    end

    pub func render(buf: basalam.Buffer, bounds: basalam.Rect):
        mut mark := " "
        if buf.focused:
            mark = "*"
        end
        buf.put_str(bounds.x, bounds.y, mark + this.name + this.keys, "")
    end
end

func rect(x: int, y: int, w: int, h: int): basalam.Rect:
    ret basalam.Rect { x = x, y = y, width = w, height = h }
end

func trail(): str:
    mut out := ""
    each i, v in visits:
        if i > 0:
            out = out + ">"
        end
        out = out + v
    end
    visits.clear()
    ret out
end

// ---- Nearest, on plain rects ------------------------------------------

func test_nearest_picks_smallest_gap():
    from := rect(0, 0, 4, 2)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    cs.push(rect(10, 0, 2, 2))
    cs.push(rect(6, 0, 2, 2))
    cs.push(rect(20, 0, 2, 2))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 1)
end

func test_nearest_requires_perpendicular_overlap():
    from := rect(0, 0, 4, 2)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    // Closer, but entirely below from's rows: not "to the right".
    cs.push(rect(5, 2, 2, 2))
    // Corner-touching: rows 2..3 against from's rows 0..1, no shared row.
    cs.push(rect(4, 2, 1, 1))
    // Farther, but shares row 1.
    cs.push(rect(30, 1, 2, 5))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 2)
    // Nothing overlaps vertically above from.
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirUp), -1)
end

func test_nearest_requires_lying_beyond_the_edge():
    from := rect(0, 0, 4, 2)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    // Overlaps from along x: beside it, not to its right.
    cs.push(rect(3, 0, 4, 2))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), -1)
    // Touching edge (gap 0) qualifies.
    cs.push(rect(4, 1, 1, 1))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 1)
end

func test_nearest_tie_break_by_alignment():
    from := rect(0, 4, 4, 2)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    // Same gap (2). The first spans rows 0..5 (center 3), the second rows
    // 4..6 (center 5.5 vs from's 5): the second is better aligned.
    cs.push(rect(6, 0, 2, 6))
    cs.push(rect(6, 4, 2, 3))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 1)
end

func test_nearest_half_cell_alignment_is_exact():
    // from covers rows 0..2, so its center row is 1.5.
    from := rect(0, 0, 2, 3)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    // Rows 1..2 (center 2.0) and rows 0..1 (center 1.0) are both half a
    // row off: a true tie, so the earlier candidate (index 0) wins.
    // Truncated integer centers (from 1, first 2, second 1) would wrongly
    // call the second one perfectly aligned and pick index 1.
    cs.push(rect(4, 1, 1, 2))
    cs.push(rect(4, 0, 1, 2))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 0)
end

func test_nearest_full_tie_keeps_earliest():
    from := rect(4, 4, 2, 2)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    cs.push(rect(0, 0, 0, 0))
    cs.push(rect(4, 0, 2, 2))
    cs.push(rect(4, 0, 2, 2))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirUp), 1)
end

func test_nearest_each_direction():
    from := rect(10, 10, 4, 4)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    cs.push(rect(10, 2, 4, 4))
    cs.push(rect(10, 16, 4, 4))
    cs.push(rect(2, 10, 4, 4))
    cs.push(rect(18, 10, 4, 4))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirUp), 0)
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirDown), 1)
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirLeft), 2)
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 3)
    testing.AssertEqInt(basalam.Nearest(from, cs, 99), -1)
end

func test_nearest_negative_and_empty():
    from := rect(-10, -3, 3, 3)
    mut cs := Vector {} as Vector<basalam.Rect>
    defer cs.free()
    cs.push(rect(-5, -2, 2, 1))
    testing.AssertEqInt(basalam.Nearest(from, cs, basalam.DirRight), 0)
    // An empty source rect overlaps nothing, so nothing qualifies.
    testing.AssertEqInt(basalam.Nearest(rect(-10, -3, 0, 3), cs, basalam.DirRight), -1)
    // Empty candidates are never chosen.
    mut empty := Vector {} as Vector<basalam.Rect>
    defer empty.free()
    empty.push(rect(-5, -2, 0, 0))
    testing.AssertEqInt(basalam.Nearest(from, empty, basalam.DirRight), -1)
end

// ---- Screen focus ------------------------------------------------------

// Layout used below (a 2x2 grid plus an unfocusable label):
//
//     a(1) b(2)          ids 1, 2 on row 0
//     c(3) d(4)          ids 3, 4 on row 1
//     label(5)           not focusable
func grid(): basalam.Screen:
    mut s := basalam.NewScreen(basalam.BaseWidget {}, 8, 3)
    a := s.add(basalam.RootId, Tile { name = "a" })
    b := s.add(basalam.RootId, Tile { name = "b" })
    c := s.add(basalam.RootId, Tile { name = "c" })
    d := s.add(basalam.RootId, Tile { name = "d" })
    label := s.add(basalam.RootId, basalam.BaseWidget {})
    s.widget(a).set_bounds(rect(0, 0, 4, 1))
    s.widget(b).set_bounds(rect(4, 0, 4, 1))
    s.widget(c).set_bounds(rect(0, 1, 4, 1))
    s.widget(d).set_bounds(rect(4, 1, 4, 1))
    s.widget(label).set_bounds(rect(0, 2, 8, 1))
    ret s
end

func test_auto_focus_first_focusable():
    mut s := grid()
    defer s.close()
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertEqInt(s.focus_stack.len(), 1)
end

func test_no_focusable_means_no_focus():
    mut s := basalam.NewScreen(basalam.BaseWidget {}, 4, 1)
    defer s.close()
    _ := s.add(basalam.RootId, basalam.BaseWidget {})
    testing.AssertEqInt(s.focused_id(), basalam.NoWidget)
    testing.AssertFalse(s.focus_next())
    testing.AssertFalse(s.focus_right())
end

func test_linear_order_wraps_and_skips():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_next())
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 4)
    // The label (5) and the root (0) are not focusable: wrap to a.
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 1)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 4)
end

func test_linear_from_nothing():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), basalam.NoWidget)
    testing.AssertTrue(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.pop_focus())
    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), 1)
end

func test_single_focusable_cannot_move():
    mut s := basalam.NewScreen(basalam.BaseWidget {}, 4, 1)
    defer s.close()
    _ := s.add(basalam.RootId, Tile { name = "x" })
    testing.AssertFalse(s.focus_next())
    testing.AssertFalse(s.focus_prev())
    testing.AssertEqInt(s.focused_id(), 1)
end

func test_spatial_moves():
    mut s := grid()
    defer s.close()
    testing.AssertTrue(s.focus_right())
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertTrue(s.focus_down())
    testing.AssertEqInt(s.focused_id(), 4)
    testing.AssertTrue(s.focus_left())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertTrue(s.focus_up())
    testing.AssertEqInt(s.focused_id(), 1)
    // Edges: nothing further up or left; the focus stays put.
    testing.AssertFalse(s.focus_up())
    testing.AssertFalse(s.focus_left())
    testing.AssertEqInt(s.focused_id(), 1)
    // Down from c: only the unfocusable label is below.
    testing.AssertTrue(s.focus_down())
    testing.AssertFalse(s.focus_down())
    testing.AssertEqInt(s.focused_id(), 3)
end

func test_explicit_focus_and_stack():
    mut s := grid()
    defer s.close()
    testing.AssertFalse(s.focus(5))
    testing.AssertFalse(s.focus(0))
    testing.AssertFalse(s.focus(42))
    testing.AssertTrue(s.focus(3))
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertEqInt(s.focus_stack.len(), 1)
    // A "dialog" takes the focus, then gives it back.
    testing.AssertTrue(s.push_focus(2))
    testing.AssertEqInt(s.focused_id(), 2)
    testing.AssertEqInt(s.focus_stack.len(), 2)
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), 3)
    testing.AssertFalse(s.push_focus(5))
    testing.AssertEqInt(s.focus_stack.len(), 1)
    testing.AssertTrue(s.pop_focus())
    testing.AssertFalse(s.pop_focus())
end

func test_focus_change_marks_dirty_and_updates_field():
    mut s := grid()
    defer s.close()
    s.present()
    testing.AssertFalse(s.dirty)
    testing.AssertTrue(s.focus_next())
    testing.AssertTrue(s.dirty)
    testing.AssertEqInt(s.focused.bounds().x, 4)
    testing.AssertEqInt(s.focused.bounds().y, 0)
    _ := s.pop_focus()
    // With nothing focused, `focused` falls back to the root.
    testing.AssertEqInt(s.focused.bounds().width, 8)
end

func test_dispatch_goes_to_focused_widget():
    mut s := grid()
    defer s.close()
    k := basalam.Event { kind = basalam.KeyEvent, key = term.Decode("k") }
    testing.AssertTrue(s.focus(4))
    testing.AssertTrue(s.dispatch(k))
    testing.AssertTrue(s.dispatch(k))
    testing.AssertTrue(s.focus_left())
    testing.AssertTrue(s.dispatch(k))
    s.present()
    testing.AssertEqStr(s.buffer.row_text(1), "*c1  d2 ")
end

func test_dispatch_with_empty_stack_starts_at_root():
    mut s := grid()
    defer s.close()
    // Drop the auto-focus so nothing is focused: dispatch then starts at
    // the root, which consumes nothing, and no tile is visited.
    testing.AssertTrue(s.pop_focus())
    testing.AssertEqInt(s.focused_id(), basalam.NoWidget)
    visits.clear()
    k := basalam.Event { kind = basalam.KeyEvent, key = term.Decode("k") }
    testing.AssertFalse(s.dispatch(k))
    testing.AssertEqStr(trail(), "")
end

func test_dispatch_routes_through_focus_stack():
    mut s := grid()
    defer s.close()
    k := basalam.Event { kind = basalam.KeyEvent, key = term.Decode("k") }
    testing.AssertEqInt(s.focused_id(), 1)
    // A pushed widget takes the keys, replacing the previous focus.
    testing.AssertTrue(s.push_focus(2))
    visits.clear()
    testing.AssertTrue(s.dispatch(k))
    testing.AssertEqStr(trail(), "b")
    // Popping gives the keys back to the widget underneath.
    testing.AssertTrue(s.pop_focus())
    testing.AssertTrue(s.dispatch(k))
    testing.AssertEqStr(trail(), "a")
end

func test_indicator_follows_focus():
    mut s := grid()
    defer s.close()
    s.present()
    testing.AssertEqStr(s.buffer.row_text(0), "*a0  b0 ")
    testing.AssertTrue(s.focus_right())
    s.present()
    testing.AssertEqStr(s.buffer.row_text(0), " a0 *b0 ")
end

func main:
    test_nearest_picks_smallest_gap()
    test_nearest_requires_perpendicular_overlap()
    test_nearest_requires_lying_beyond_the_edge()
    test_nearest_tie_break_by_alignment()
    test_nearest_half_cell_alignment_is_exact()
    test_nearest_full_tie_keeps_earliest()
    test_nearest_each_direction()
    test_nearest_negative_and_empty()
    test_auto_focus_first_focusable()
    test_no_focusable_means_no_focus()
    test_linear_order_wraps_and_skips()
    test_linear_from_nothing()
    test_single_focusable_cannot_move()
    test_spatial_moves()
    test_explicit_focus_and_stack()
    test_focus_change_marks_dirty_and_updates_field()
    test_dispatch_goes_to_focused_widget()
    test_dispatch_with_empty_stack_starts_at_root()
    test_dispatch_routes_through_focus_stack()
    test_indicator_follows_focus()
    visits.free()
    ret testing.Summary()
end
