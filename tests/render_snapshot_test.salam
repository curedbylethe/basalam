// Whole-frame snapshot tests for composed widget scenes. No terminal is used:
// the screen is never start()ed, so present() only paints into the buffer and
// every assertion reads that buffer. The text frames join the rows of the
// screen's buffer; one small literal ANSI frame pins styling that text cannot
// show.

import str
import testing
import term

include "../basalam/basalam.salam"

// Widget ids in scene(), fixed by add order.
SaveId := 3
WrapId := 4

// Draws "no" in reverse video. Text's Style has no reverse attribute, so this
// keeps the ANSI snapshot a real reverse-video cell.
struct RevText:
    pub use basalam.BaseWidget
    pub text: str = ""

    pub func render(buf: basalam.Buffer, bounds: basalam.Rect):
        buf.put_str(bounds.x, bounds.y, this.text, term.Sgr(term.StyleReverse))
    end
end

func rect(x: int, y: int, w: int, h: int): basalam.Rect:
    ret basalam.Rect { x = x, y = y, width = w, height = h }
end

// Joins every buffer row with "|", so a frame is one comparable string.
func frame(s: basalam.Screen): str:
    mut out := ""
    repeat s.buffer.height in y:
        if y > 0:
            out = out + "|"
        end
        out = out + s.buffer.row_text(y)
    end
    ret out
end

// The composed scene shared by the snapshot tests: title, rule, button,
// checkbox, progress and status on a 24x6 screen.
func scene(): basalam.Screen:
    mut s := basalam.NewScreen(basalam.BaseWidget {}, 24, 6)
    title := s.add(basalam.RootId, basalam.NewText("basalam") as dyn basalam.Widget)
    s.widget(title).set_bounds(rect(1, 0, 10, 1))
    rule := s.add(basalam.RootId, basalam.NewSeparator() as dyn basalam.Widget)
    s.widget(rule).set_bounds(rect(1, 1, 20, 1))
    save := s.add(basalam.RootId, basalam.NewButton("Save") as dyn basalam.Widget)
    s.widget(save).set_bounds(rect(1, 2, 10, 1))
    wrap := s.add(basalam.RootId, basalam.NewCheckbox("Wrap", true) as dyn basalam.Widget)
    s.widget(wrap).set_bounds(rect(12, 2, 10, 1))
    mut p := basalam.NewProgress()
    p.set_progress(40)
    load := s.add(basalam.RootId, p as dyn basalam.Widget)
    s.widget(load).set_bounds(rect(1, 3, 20, 1))
    status := s.add(basalam.RootId, basalam.NewText("ready") as dyn basalam.Widget)
    s.widget(status).set_bounds(rect(1, 4, 20, 1))
    ret s
end

func test_scene_frame_is_a_snapshot():
    mut s := scene()
    defer s.close()
    testing.AssertTrue(s.focus(SaveId))
    testing.AssertEqInt(s.focused_id(), SaveId)
    s.present()
    testing.AssertEqStr(frame(s), " basalam                | ────────────────────   | [  Save  ] [x] Wrap    | ######---------  40%   | ready                  |                        ")
end

// Focus must repaint style only, never shift a glyph.
func test_focus_changes_only_styles():
    mut s := scene()
    defer s.close()
    testing.AssertTrue(s.focus(SaveId))
    s.present()
    before := frame(s)
    save_style := s.buffer.get(1, 2).style
    wrap_style := s.buffer.get(12, 2).style
    testing.AssertNeStr(save_style, "")

    testing.AssertTrue(s.focus_next())
    testing.AssertEqInt(s.focused_id(), WrapId)
    s.present()
    testing.AssertEqStr(frame(s), before)
    testing.AssertEqStr(s.buffer.get(1, 2).style, "")
    testing.AssertNeStr(s.buffer.get(12, 2).style, "")
    testing.AssertNeStr(save_style, s.buffer.get(1, 2).style)
    testing.AssertNeStr(wrap_style, s.buffer.get(12, 2).style)
end

// A widget wider than the screen is cut at the buffer edge, not wrapped.
func test_clipped_widget_frame():
    mut s := basalam.NewScreen(basalam.BaseWidget {}, 12, 2)
    defer s.close()
    id := s.add(basalam.RootId, basalam.NewText("abcdefghijklmnop") as dyn basalam.Widget)
    s.widget(id).set_bounds(rect(0, 0, 30, 1))
    s.present()

    testing.AssertEqInt(str.CharCount(s.buffer.row_text(0)), s.buffer.width)
    testing.AssertEqInt(str.CharCount(s.buffer.row_text(1)), s.buffer.width)
    testing.AssertEqStr(frame(s), "abcdefghijkl|            ")
end

// One literal 8x2 ANSI frame: bold and reverse survive into the bytes.
func test_ansi_frame_snapshot():
    mut s := basalam.NewScreen(basalam.BaseWidget {}, 8, 2)
    defer s.close()
    mut ok := basalam.NewText("ok")
    ok.set_style(basalam.Style { bold = true })
    oid := s.add(basalam.RootId, ok as dyn basalam.Widget)
    s.widget(oid).set_bounds(rect(0, 0, 2, 1))
    nid := s.add(basalam.RootId, RevText { text = "no" } as dyn basalam.Widget)
    s.widget(nid).set_bounds(rect(4, 0, 2, 1))
    s.present()

    testing.AssertEqStr(s.buffer.ansi(), "\x1b[1;1H\x1b[0m\x1b[1mok\x1b[0m  \x1b[0m\x1b[7mno\x1b[0m  \x1b[2;1H        \x1b[0m")
end

func main:
    test_scene_frame_is_a_snapshot()
    test_focus_changes_only_styles()
    test_clipped_widget_frame()
    test_ansi_frame_snapshot()
    ret testing.Summary()
end
