// Tests for the Separator widget: the paint vectors SP01-SP07 (orientation is
// a field, not the rect's shape; only the first row or column is painted), the
// rune vectors SP04 and SP08, the style and background rules, the predicates
// (never focusable, never hittable, consumes no event), and the preferred size
// and measure for both orientations. Buffers that must show "not painted" are
// pre-filled with "x", so an untouched cell is distinguishable from a blank.
// SGR strings are built with StyleSgr at TrueColor, never written by hand.

import testing
import term

include "../basalam/basalam.salam"

func rect(x: int, y: int, w: int, h: int): basalam.Rect:
    ret basalam.Rect { x = x, y = y, width = w, height = h }
end

func key(seq: str): basalam.Event:
    ret basalam.Event { kind = basalam.KeyEvent, key = term.Decode(seq) }
end

// Renders s into a fresh w x h buffer pre-filled with "x", with bounds at the
// origin. The caller frees the buffer.
func draw(s: basalam.Separator, w: int, h: int): basalam.Buffer:
    b := basalam.NewBuffer(w, h)
    b.fill(rect(0, 0, w, h), "x", "")
    s.render(b, rect(0, 0, w, h))
    ret b
end

// ---- Paint vectors SP01-SP07 -------------------------------------------

func test_horizontal_paint():
    s := basalam.NewSeparator()

    // SP01: 8x1 horizontal, default rune.
    a := draw(s, 8, 1)
    defer a.free()
    testing.AssertEqStr(a.row_text(0), "────────")

    // SP03: 8x3 horizontal paints row 0 only; rows 1-2 keep the pre-fill.
    b := draw(s, 8, 3)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "────────")
    testing.AssertEqStr(b.row_text(1), "xxxxxxxx")
    testing.AssertEqStr(b.row_text(2), "xxxxxxxx")
end

func test_vertical_paint():
    mut s := basalam.NewSeparator()
    s.set_orientation(basalam.Orientation.Vertical)

    // SP02: 1x4 vertical, default rune.
    a := draw(s, 1, 4)
    defer a.free()
    testing.AssertEqStr(a.get(0, 0).ch, "│")
    testing.AssertEqStr(a.get(0, 1).ch, "│")
    testing.AssertEqStr(a.get(0, 2).ch, "│")
    testing.AssertEqStr(a.get(0, 3).ch, "│")

    // SP05: 3x3 vertical paints column 0 only; columns 1-2 keep the pre-fill.
    b := draw(s, 3, 3)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "│xx")
    testing.AssertEqStr(b.row_text(1), "│xx")
    testing.AssertEqStr(b.row_text(2), "│xx")
end

func test_single_cell():
    // SP07: 1x1 paints exactly one rune, for either orientation.
    h := basalam.NewSeparator()
    a := draw(h, 1, 1)
    defer a.free()
    testing.AssertEqStr(a.row_text(0), "─")

    mut v := basalam.NewSeparator()
    v.set_orientation(basalam.Orientation.Vertical)
    b := draw(v, 1, 1)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "│")
end

// ---- Rune vectors SP04 and SP08 ----------------------------------------

func test_custom_rune():
    // SP04: ch = "=" renders a run of "=".
    mut s := basalam.NewSeparator()
    testing.AssertTrue(s.set_ch("="))
    a := draw(s, 5, 1)
    defer a.free()
    testing.AssertEqStr(a.row_text(0), "=====")
end

func test_set_ch_rejects_wide():
    // SP08: a wide rune is refused; the default rune still renders.
    mut s := basalam.NewSeparator()
    testing.AssertFalse(s.set_ch("中"))
    a := draw(s, 4, 1)
    defer a.free()
    testing.AssertEqStr(a.row_text(0), "────")

    // A later valid rune is accepted and renders.
    testing.AssertTrue(s.set_ch("-"))
    b := draw(s, 4, 1)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "----")
end

func test_set_ch_rejects_zero_width_keeps_previous():
    mut s := basalam.NewSeparator()
    testing.AssertTrue(s.set_ch("="))
    testing.AssertFalse(s.set_ch("​"))
    a := draw(s, 3, 1)
    defer a.free()
    testing.AssertEqStr(a.row_text(0), "===")

    // The empty string resets to the orientation's default rune.
    testing.AssertTrue(s.set_ch(""))
    b := draw(s, 3, 1)
    defer b.free()
    testing.AssertEqStr(b.row_text(0), "───")
end

// ---- Zero length paints nothing (SP06) ----------------------------------

func test_zero_length_paints_nothing():
    s := basalam.NewSeparator()
    b := basalam.NewBuffer(4, 1)
    defer b.free()
    b.fill(rect(0, 0, 4, 1), "x", "")
    before := b.row_text(0)
    s.render(b, rect(0, 0, 0, 1))
    testing.AssertEqStr(b.row_text(0), before)
    testing.AssertEqStr(b.row_text(0), "xxxx")
end

// ---- Style and background -----------------------------------------------

func test_style_fg_and_bg():
    mut s := basalam.NewSeparator()
    st := basalam.Style { fg = basalam.Green, bg = basalam.Color.Ansi(4) }
    s.set_style(st)

    // Rune cells carry the full style, background included.
    b := basalam.NewBuffer(6, 3)
    defer b.free()
    b.fill(rect(0, 0, 6, 3), "x", "")
    s.render(b, rect(0, 0, 3, 3))
    want_rune := basalam.StyleSgr(st, basalam.ColorTier.TrueColor)
    testing.AssertEqStr(b.get(0, 0).style, want_rune)
    testing.AssertEqStr(b.get(0, 0).ch, "─")

    // An off-line cell inside the rect is filled with the background only.
    want_bg := basalam.StyleSgr(basalam.Style { bg = basalam.Color.Ansi(4) }, basalam.ColorTier.TrueColor)
    testing.AssertEqStr(b.get(1, 1).style, want_bg)
    testing.AssertEqStr(b.get(1, 1).ch, " ")

    // A cell outside the rect is untouched.
    testing.AssertEqStr(b.get(4, 0).ch, "x")
    testing.AssertEqStr(b.get(4, 0).style, "")
end

func test_style_fg_without_bg_leaves_off_line_cells():
    mut s := basalam.NewSeparator()
    s.set_style(basalam.Style { fg = basalam.Green })
    b := basalam.NewBuffer(4, 3)
    defer b.free()
    b.fill(rect(0, 0, 4, 3), "x", "")
    s.render(b, rect(0, 0, 4, 3))
    testing.AssertEqStr(b.get(0, 0).style, basalam.StyleSgr(basalam.Style { fg = basalam.Green }, basalam.ColorTier.TrueColor))
    testing.AssertEqStr(b.row_text(1), "xxxx")
    testing.AssertEqStr(b.get(0, 1).style, "")
end

// ---- Predicates ----------------------------------------------------------

func test_predicates():
    mut s := basalam.NewSeparator()
    testing.AssertFalse(s.focusable())
    testing.AssertFalse(s.hits())
    testing.AssertFalse(s.handle_event(key("q")))
    s.set_orientation(basalam.Orientation.Vertical)
    testing.AssertFalse(s.focusable())
    testing.AssertFalse(s.hits())
    testing.AssertFalse(s.handle_event(key("q")))
end

func test_defaults():
    s := basalam.NewSeparator()
    testing.AssertTrue(s.orientation == basalam.Orientation.Horizontal)
    testing.AssertEqStr(s.ch, "")
    testing.AssertTrue(basalam.StyleEq(s.style, basalam.StyleDefault))
end

// ---- preferred_size and measure -----------------------------------------

func test_preferred_size_and_measure():
    h := basalam.NewSeparator()
    hp := h.preferred_size(10)
    testing.AssertEqInt(hp.width, -1)
    testing.AssertEqInt(hp.height, 1)

    mut v := basalam.NewSeparator()
    v.set_orientation(basalam.Orientation.Vertical)
    vp := v.preferred_size(10)
    testing.AssertEqInt(vp.width, 1)
    testing.AssertEqInt(vp.height, -1)

    // Horizontal: the main axis is X and fills max_width; Y is one cell.
    hx := h.measure(basalam.Axis.X, 10)
    testing.AssertTrue(hx.ok)
    testing.AssertEqInt(hx.extent, 10)
    hy := h.measure(basalam.Axis.Y, 10)
    testing.AssertTrue(hy.ok)
    testing.AssertEqInt(hy.extent, 1)

    // Vertical: the main axis is Y and fills max_width; X is one cell.
    vx := v.measure(basalam.Axis.X, 10)
    testing.AssertTrue(vx.ok)
    testing.AssertEqInt(vx.extent, 1)
    vy := v.measure(basalam.Axis.Y, 10)
    testing.AssertTrue(vy.ok)
    testing.AssertEqInt(vy.extent, 10)
end

func main:
    test_horizontal_paint()
    test_vertical_paint()
    test_single_cell()
    test_custom_rune()
    test_set_ch_rejects_wide()
    test_set_ch_rejects_zero_width_keeps_previous()
    test_zero_length_paints_nothing()
    test_style_fg_and_bg()
    test_style_fg_without_bg_leaves_off_line_cells()
    test_predicates()
    test_defaults()
    test_preferred_size_and_measure()
    ret testing.Summary()
end
