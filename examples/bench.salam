/*
 * basalam - a terminal user interface library for Salam (2026)
 *
 *   +-------------------+
 *   |   B A S A L A M   |
 *   +-------------------+
 *
 * Built on the Salam standard library's std/term package
 * Salam: https://github.com/SalamLang/Salam
 *
 * Repository: https://github.com/curedbylethe/basalam
 * License: GPL-3.0-or-later
 *
 */

// Benchmark, not a newcomer program. Headless 200x60 frame timing.
// Never calls start(), loop(), or next_event(). present() flushes only
// when attached; this process never attaches, so the run is silent.
// A frame mutates, marks that change, then does what flush() does minus
// term.Emit: present, diff, commit. A small frame marks one widget with
// invalidate. str has no free, so diff strings accumulate.
// Fine for this short run, not for library code.
// dyn Widget is a boxed copy with no downcast, so set_progress cannot
// reach a boxed Progress and that widget is omitted. Text and Button
// rewrite one byte of a captured heap str. List shares its Vector.
// Input and Checkbox change through handle_event.

import conv
import mem
import str
import term
import time

include "../basalam/basalam.salam"

const Warmup := 100
const Measured := 1000

mut texts := Vector {} as Vector<str>
mut rows_a := Vector {} as Vector<str>
mut rows_b := Vector {} as Vector<str>
mut input_a := basalam.BaseWidget {} as dyn basalam.Widget
mut input_b := basalam.BaseWidget {} as dyn basalam.Widget
mut box := basalam.BaseWidget {} as dyn basalam.Widget
// Screen ids in mutate_one slot order. main fills this.
mut slots := Vector {} as Vector<int>

func heap(s: str): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, s)
    out := str.BufStr(b)
    str.BufFree(b)
    ret out
end
func poke(s: str, digit: int):
    p := (s as void*) as i8*
    p[0] = (48 + (digit % 10)) as i8
end
func put_row(rows &: Vector<str>, n: int):
    rows.set(n % rows.len(), "item " + term.PadLeft(str.FromInt(n % 10000), 4) + " ----------------")
end
func key(code: int, ch: str): basalam.Event:
    ret basalam.Event { kind = basalam.KeyEvent, key = term.Key { code = code, ch = ch } }
end
// Backspace, then one digit: the field stays one cell and still changes.
func type_digit(w: dyn basalam.Widget, digit: int):
    ch := str.CharSubstr("0123456789", digit % 10, 1)
    _ := w.handle_event(key(term.KeyBackspace, ""))
    _ := w.handle_event(key(term.KeyChar, ch))
end
func mutate_all(n: int):
    repeat texts.len() in i:
        poke(texts.get(i), n)
    end
    put_row(rows_a, n)
    put_row(rows_b, n + 3)
    type_digit(input_a, n)
    type_digit(input_b, n + 1)
    _ := box.handle_event(key(term.KeySpace, ""))
end
// 0-4 heap strings (four Text, then Button), 5-6 lists, 7 input, 8 checkbox, 9 input.
// d = n/10 so a widget that runs every 10th frame still changes.
func mutate_one(n: int):
    w := n % 10
    d := n / 10
    if w < 5: poke(texts.get(w), d) ret end
    if w == 5: put_row(rows_a, n) ret end
    if w == 6: put_row(rows_b, n) ret end
    if w == 7: type_digit(input_a, d) ret end
    if w == 8: _ := box.handle_event(key(term.KeySpace, "")) ret end
    type_digit(input_b, d)
end
func frame(screen &: basalam.Screen, n: int, small: bool): int:
    if small:
        mutate_one(n)
        // n%10 is a slot, not a screen id.
        screen.invalidate(slots.get(n % 10))
    else:
        mutate_all(n)
        screen.dirty = true
    end
    screen.present()
    // flush() minus term.Emit. The diff str is dropped on purpose.
    out := screen.buffer.diff()
    screen.buffer.commit()
    ret out.len()
end
func report(mode: str, ms: f64, bytes: int):
    println "mode " + mode
    println "frames " + Measured
    println "total_ms " + conv.FormatFloatPrec(ms, 3)
    println "ms_per_frame " + conv.FormatFloatPrec(ms / (Measured as f64), 4)
    println "bytes_per_frame " + (bytes / Measured)
    if mem.IsMemDebug():
        println "allocs " + mem.AllocCount()
        println "frees " + mem.FreeCount()
        println "live_bytes " + mem.LiveBytes()
        println "peak_bytes " + mem.PeakBytes()
    end
end
func run_mode(screen &: basalam.Screen, mode: str, small: bool):
    repeat Warmup in i:
        _ := frame(screen, i, small)
    end
    mut bytes := 0
    t0 := time.NowNanos()
    repeat Measured in i:
        bytes = bytes + frame(screen, Warmup + i, small)
    end
    report(mode, time.ElapsedMs(t0, time.NowNanos()), bytes)
end
func add_child(root &: basalam.Column, kids &: Vector<dyn basalam.Widget>, w: dyn basalam.Widget, h: int):
    i := root.add(w)
    root.set_height(i, basalam.LayoutSize { kind = basalam.SizeKind.Fixed, cells = h })
    kids.push(w)
end
func main:
    texts.push(heap("0 text-header ......................"))
    texts.push(heap("0 text-body ........................"))
    texts.push(heap("0 text-mid ........................."))
    texts.push(heap("0 text-foot ........................"))
    texts.push(heap("0 go"))
    repeat 8:
        rows_a.push("item 0000 ----------------")
        rows_b.push("item 0000 ----------------")
    end
    mut root := basalam.NewColumn()
    mut kids := Vector {} as Vector<dyn basalam.Widget>
    // Heights 2+4+18+16+8+1+1+1+1+8 = 60. Stretch fills width 200.
    add_child(root, kids, basalam.NewText(texts.get(0)) as dyn basalam.Widget, 2)
    add_child(root, kids, basalam.NewText(texts.get(1)) as dyn basalam.Widget, 4)
    add_child(root, kids, basalam.NewList(rows_a) as dyn basalam.Widget, 18)
    add_child(root, kids, basalam.NewList(rows_b) as dyn basalam.Widget, 16)
    add_child(root, kids, basalam.NewText(texts.get(2)) as dyn basalam.Widget, 8)
    input_a = basalam.NewInput() as dyn basalam.Widget
    add_child(root, kids, input_a, 1)
    box = basalam.NewCheckbox("flag", false) as dyn basalam.Widget
    add_child(root, kids, box, 1)
    add_child(root, kids, basalam.NewButton(texts.get(4)) as dyn basalam.Widget, 1)
    input_b = basalam.NewInput() as dyn basalam.Widget
    add_child(root, kids, input_b, 1)
    add_child(root, kids, basalam.NewText(texts.get(3)) as dyn basalam.Widget, 8)
    mut screen := basalam.NewScreen(root as dyn basalam.Widget, 200, 60)
    defer screen.close()
    mut kid_ids := Vector {} as Vector<int>
    repeat kids.len() in i:
        kid_ids.push(screen.add(basalam.RootId, kids.get(i)))
    end
    // header, body, mid, foot, button, list a, list b, input a, checkbox, input b
    slots.push(kid_ids.get(0))
    slots.push(kid_ids.get(1))
    slots.push(kid_ids.get(4))
    slots.push(kid_ids.get(9))
    slots.push(kid_ids.get(7))
    slots.push(kid_ids.get(2))
    slots.push(kid_ids.get(3))
    slots.push(kid_ids.get(5))
    slots.push(kid_ids.get(6))
    slots.push(kid_ids.get(8))
    kid_ids.free()
    run_mode(screen, "full", false)
    println ""
    run_mode(screen, "small", true)
    ret 0
end
