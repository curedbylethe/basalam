/*
 * Signal: the SIGWINCH listening primitives Screen uses to turn a terminal
 * resize into a wake-up.
 *
 * A terminal reports a resize out of band as SIGWINCH; polling the size is
 * the only portable alternative and it is both slower and laggier. This
 * module owns the process-wide plumbing: it installs the signal handler,
 * blocks SIGWINCH so the signal is queued rather than delivered on an
 * arbitrary thread, and hands Screen a set to wait on. Screen (screen.salam)
 * consumes exactly these six functions and owns all of the policy (when to
 * start the watcher, how a wake-up becomes a ResizeEvent); nothing here
 * knows about terminals, buffers, or widgets.
 *
 * The handler is a deliberate no-op. Its only job is to give SIGWINCH a
 * disposition other than SIG_DFL: on Darwin a blocked signal whose
 * disposition is the default ignore is discarded at generation, so without
 * an installed handler a self- or terminal-raised SIGWINCH would vanish and
 * sigwait would block forever. The signal number carries no information
 * (SIGWINCH means "the size may have changed"), so the handler has nothing
 * to record; Screen re-reads the size after every wake-up instead.
 *
 * Deliberate non-goals. No handler body: the handler runs on the signal
 * delivery thread and must stay async-signal-safe. No sigtimedwait (it does
 * not exist on macOS) and no SIGALRM timeouts. No sigaddset/sigemptyset:
 * they are macros on Darwin and would not link, so the mask is built by
 * hand. All of the above are Windows-free: on Windows there is no SIGWINCH,
 * so every function is a safe stub and WinchSupported reports false so
 * callers can fall back to polling.
 */

package basalam

// mem is imported only on POSIX. Every use of it lives in the POSIX halves
// of the platform branches below; on Windows those halves are not compiled
// and an import nothing uses is an error (E082), so the import has to go
// away with them.
if not SALAM_OS_WINDOWS:
    import mem
end

if not SALAM_OS_WINDOWS:
    extern:
        func signal(sig: int, handler: void*): void*
        func sigprocmask(how: int, set: void*, old: void*): int
        func sigwait(set: void*, sig: void*): int
        func kill(pid: int, sig: int): int
        func getpid(): int
    end
end

@en "WinchSignal"
/// The SIGWINCH number. It is 28 on macOS and Linux, the only platforms
/// the watch is enabled on.
pub const WinchSignal := 28

@en "SignalBlock"
/// The how argument of sigprocmask that adds a signal to the blocked set
/// (SIG_BLOCK), the same value on macOS and Linux.
pub const SignalBlock := 1

if not SALAM_OS_WINDOWS:
    export:
        func winch_noop(_sig: int):
            // Deliberate no-op, kept async-signal-safe. It exists only to
            // give SIGWINCH a non-default disposition; the argument is the
            // signal number and carries no information (see the module
            // comment). The discard keeps the body non-empty as the
            // compiler requires without doing any work.
            _ := _sig
        end
    end
end

@en "WinchSupported"
/// True when this process can receive SIGWINCH, i.e. on POSIX. Windows has
/// no SIGWINCH, so the watcher must not start there and callers should poll
/// the terminal size instead.
pub func WinchSupported(): bool:
    if SALAM_OS_WINDOWS:
        ret false
    else:
        ret true
    end
end

@en "NewWinchSet"
/// Allocate a zeroed signal set containing SIGWINCH and nothing else. The
/// caller owns the memory and releases it with mem.Free. The mask is built
/// by setting bit 27 of the first 32-bit word by hand (1 << 27), because
/// sigaddset and sigemptyset are Darwin macros that would not link. The
/// same word layout is correct for the 32-bit Darwin sigset_t and the
/// 128-byte glibc one. Returns null on Windows.
pub func NewWinchSet(): void*:
    if SALAM_OS_WINDOWS:
        ret null
    else:
        set := mem.AllocateZeroed(128 as u64)
        sp := set as i32*
        sp[0] = 0x08000000
        ret set
    end
end

@en "InstallWinchHandler"
/// Install the process-wide no-op SIGWINCH handler. Call this before
/// BlockWinch: a signal blocked while its disposition is still SIG_DFL is
/// discarded at generation on Darwin, so the handler must exist first. A
/// no-op on Windows.
pub func InstallWinchHandler():
    if SALAM_OS_WINDOWS:
        ret
    else:
        _ := signal(WinchSignal, &winch_noop)
    end
end

@en "BlockWinch"
/// Add SIGWINCH to the calling thread's signal mask so the signal is queued
/// for WaitWinch instead of delivered on an arbitrary thread. Threads
/// spawned afterwards inherit the mask, which is what lets one dedicated
/// watcher thread own the wait. A no-op on Windows.
pub func BlockWinch():
    if SALAM_OS_WINDOWS:
        ret
    else:
        set := NewWinchSet()
        if set == null: ret end
        _ := sigprocmask(SignalBlock, set, null)
        mem.Free(set)
    end
end

@en "WaitWinch"
/// Block the calling thread until a SIGWINCH is queued, then return its
/// signal number. The set must contain SIGWINCH, as NewWinchSet builds, and
/// the thread must have it blocked, as BlockWinch does. Returns 0 on
/// Windows, or when set is null, so callers can treat 0 as "nothing to do".
pub func WaitWinch(set: void*): int:
    if SALAM_OS_WINDOWS:
        ret 0
    else:
        if set == null: ret 0 end
        sig := mem.AllocateZeroed(8 as u64)
        _ := sigwait(set, sig)
        n := (sig as i32*)[0]
        mem.Free(sig)
        ret n
    end
end

@en "WakeWinch"
/// Send SIGWINCH to this process so a thread parked in WaitWinch wakes up.
/// With the signal blocked this only queues it, which is exactly what the
/// watcher consumes; Screen uses it to break the wait when shutting down. A
/// no-op on Windows.
pub func WakeWinch():
    if SALAM_OS_WINDOWS:
        ret
    else:
        _ := kill(getpid(), WinchSignal)
    end
end
