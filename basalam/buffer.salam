/*
 * Buffer: the drawing surface widgets render into.
 *
 * Two grids of width x height Cells, each cell one codepoint plus a style:
 * `cells` is the back grid widgets draw into; `front` is the front grid,
 * what the terminal currently shows. Widgets never write the front grid;
 * only commit() advances it.
 *
 * Output. diff() serializes what changed: while `force_full` it is the whole
 * frame (ansi semantics); otherwise it skips clean rows and emits only the
 * maximal runs of marked cells that differ from the front grid, one cursor
 * move per run, carrying one style variable across runs and closing any
 * non-empty diff by turning the last style off. It returns "" when nothing
 * changed. flush() emits that diff (skipping the write when it is empty) and
 * commits.
 *
 *   present:  the back and front grids and the cell access they need
 *             (set/get); text and rect helpers (put_str/fill); clear;
 *             resize (reallocates both grids and forces a full repaint);
 *             per-row text for tests (row_text); clipping; a render-context
 *             flag (focused); touched-cell tracking (writes go through
 *             set/fill/put_str/clear); and output: ansi() serializes the
 *             WHOLE grid (cursor moves via term.SeqMoveTo, and the
 *             StyleSgrOff / StyleSgr pair whenever the style changes) while
 *             diff()/commit() write only the cells that changed since the
 *             last commit.
 *
 *   still absent: rectangle repaint (touched-cell tracking exists; writes
 *             go through set/fill/put_str/clear); wide characters (a cell
 *             holds one codepoint and is assumed to be one column wide) and
 *             cursor placement for text input (epic 2 follow-ups).
 *
 * Style transitions. A cell stores a Style; the buffer turns it into bytes at
 * emission, so the tier is applied once, here, and widgets never build SGR.
 * A frame starts from the terminal's default style (its first cell is drawn
 * under that assumption), every change emits StyleSgrOff(previous, tier)
 * followed by StyleSgr(next, tier), and the frame closes with
 * StyleSgrOff(last, tier) — "" when the last style is the default, so no
 * conditional is needed. A reset is not part of a frame; it belongs to
 * Screen.start / Screen.close, which set the terminal up and tear it down.
 *
 *   contract to keep: Widget.render receives a Buffer by value, writes
 *             through it reach the screen's grid, and `clip` / `focused` /
 *             `tier` are per-copy render context: `tier` set once by
 *             Screen.start, the rest by Screen.draw.
 *
 * Why widgets never touch the terminal: widgets draw here, the screen
 * decides when and how a frame reaches the terminal. That keeps rendering
 * testable without a tty (row_text / get inspect the result) and lets the
 * output strategy change without touching any widget.
 *
 * Value semantics. A Buffer is passed to Widget.render by value, but both
 * grids live in Vectors, and copies of a Vector share storage. Writing a
 * cell through any copy writes the screen's one back grid, and commit()
 * through any copy advances the shared front grid. `touched` and
 * `row_touched` are vectors too, so a copy shares the marks and a widget's
 * `set` marks the owner's grid. The scalar fields (clip, focused, tier,
 * force_full) are per-copy: the screen hands each widget its own copy with
 * `clip` set to that widget's visible area and `focused` set when it holds
 * the focus. `tier` is set once when the screen takes the terminal and every
 * copy inherits the same value: it is the tier the buffer lowers styles to
 * when it writes a frame, so widgets never read the environment themselves.
 * Only the owner of the original may resize, free, or flush it.
 */

package basalam

import str
import term

@en "Cell"
/// One terminal cell: a single codepoint and the style it is drawn with.
pub struct Cell:
    @en "ch"
    /// The character, exactly one codepoint. A blank cell holds " ".
    pub ch: str = " "

    @en "style"
    /// The resolved style this cell is drawn with. StyleDefault asks for the
    /// terminal's default style. The buffer, not the widget, turns it into
    /// bytes.
    pub style: Style = StyleDefault
end

@en "Buffer"
/// A grid of cells that widgets draw into. Writes outside `clip` (or
/// outside the grid) are silently ignored, so drawing is infallible.
pub struct Buffer:
    @en "width"
    /// Number of columns.
    pub width: int = 0

    @en "height"
    /// Number of rows.
    pub height: int = 0

    @en "cells"
    /// Row-major cell storage: the cell at (x, y) is cells[y * width + x].
    /// Prefer get and set, which bounds-check and clip. Write through
    /// `set` / `fill` / `put_str` / `clear`. Direct writes to the backing
    /// vector are outside the contract and are not tracked.
    pub cells: Vector<Cell> = Vector {}

    @en "front"
    /// The front grid: what the terminal currently shows. Same length and
    /// layout as `cells`. Widgets never write it; only commit() advances it.
    pub front: Vector<Cell> = Vector {}

    @en "clip"
    /// Writes outside this rect are dropped. NewBuffer sets it to the whole
    /// grid; the screen narrows it to each widget's bounds while that
    /// widget renders.
    pub clip: Rect = Rect {}

    @en "focused"
    /// Render context: true while the screen renders the focused widget,
    /// so the widget can draw a focus indicator. Always false outside a
    /// screen-driven render.
    pub focused: bool = false

    @en "tier"
    /// Render context: the colour capability of the terminal this buffer is
    /// drawn for. The buffer lowers every cell's Style to this tier when it
    /// emits a frame; widgets and DrawBorder only store styles.
    /// Screen.start() sets it to DetectTier() once; a buffer built by hand
    /// keeps TrueColor, so headless renders stay true colour whatever the
    /// environment says. resize() preserves it.
    pub tier: ColorTier = ColorTier.TrueColor

    @en "force_full"
    /// True when the next diff() must serialize the whole frame instead of
    /// only the changed cells. NewBuffer and resize set it; commit() clears
    /// it once the front grid has caught up with the back grid.
    pub force_full: bool = true

    // Per-cell marks plus a row summary so diff/commit skip clean rows.
    // A bbox was rejected because two corner edits would repaint everything
    // between them. Marks are Vector<bool>. The rejected int fallback would
    // have cost about 96 KB at 200×60, beside the two cell grids. Direct
    // writes to `cells` are not marked.
    touched: Vector<bool> = Vector {}
    row_touched: Vector<bool> = Vector {}

    // clear() blanks every cell, so one flag replaces a mark per cell. While
    // it is set, set() skips marking and commit() treats the whole grid as
    // changed, which keeps a full frame free of per-cell mark work.
    all_touched: bool = false

    // ansi()/diff() scratch. BufReset keeps the capacity; BufStr clones, so
    // the returned str does not alias it. resize() keeps this builder.
    // Only free() releases it. A copy shares data and has its own len, so
    // only the owner may serialize.
    out_buf: str.StringBuilder = str.StringBuilder {}

    @en "area"
    /// The rect covering the whole grid: (0, 0, width, height).
    pub func area(): Rect:
        ret Rect { width = this.width, height = this.height }
    end

    @en "set"
    /// Writes one cell. Does nothing when (x, y) is outside the grid or
    /// outside `clip`.
    pub func set(x: int, y: int, cell: Cell):
        p := Point { x = x, y = y }
        if not this.area().contains(p) or not this.clip.contains(p):
            ret
        end
        i := y * this.width + x
        this.cells.set(i, cell)
        if not this.all_touched:
            this.touched.set(i, true)
            this.row_touched.set(y, true)
        end
    end

    @en "get"
    /// Reads one cell. Returns a blank default Cell when (x, y) is outside
    /// the grid. Reading ignores `clip`.
    pub func get(x: int, y: int): Cell:
        p := Point { x = x, y = y }
        if not this.area().contains(p):
            ret Cell {}
        end
        ret this.cells.get(y * this.width + x)
    end

    @en "put_str"
    /// Writes text left to right starting at (x, y), one codepoint per
    /// cell, all in the same style. Text that runs past the clip or the
    /// grid is cut off; it never wraps.
    pub func put_str(x: int, y: int, text: str, style: Style):
        mut i := 0
        mut col := 0
        n := text.len()
        until i < n:
            ch := str.CharAt(text, i)
            if ch == "":
                break
            end
            this.set(x + col, y, Cell { ch = ch, style = style })
            col += 1
            i += ch.len()
        end
    end

    @en "fill"
    /// Sets every cell of r (clipped) to the same character and style.
    pub func fill(r: Rect, ch: str, style: Style):
        repeat r.height in dy:
            repeat r.width in dx:
                this.set(r.x + dx, r.y + dy, Cell { ch = ch, style = style })
            end
        end
    end

    @en "clear"
    /// Resets every cell of the grid to a blank default Cell, ignoring
    /// `clip`. The next diff() and commit() treat every cell as changed.
    pub func clear():
        repeat this.cells.len() in i:
            this.cells.set(i, Cell {})
        end
        this.all_touched = true
    end

    @en "row_text"
    /// The characters of row y joined into one string, without styles.
    /// Returns "" for a row outside the grid. Meant for tests and debugging.
    pub func row_text(y: int): str:
        if y < 0 or y >= this.height:
            ret ""
        end
        mut b := str.NewBuilder()
        defer str.BufFree(b)
        repeat this.width in x:
            str.BufAppend(b, this.cells.get(y * this.width + x).ch)
        end
        ret str.BufStr(b)
    end

    @en "resize"
    /// Replaces both grids with blank width x height ones and resets clip to
    /// cover them, forcing a full repaint on the next diff(). Only the owner
    /// of the original Buffer may call this: it frees the old storage that
    /// copies were sharing.
    pub func resize(width: int, height: int):
        this.cells.free()
        this.front.free()
        this.touched.free()
        this.row_touched.free()
        fresh := NewBuffer(width, height)
        this.width = fresh.width
        this.height = fresh.height
        this.cells = fresh.cells
        this.front = fresh.front
        this.touched = fresh.touched
        this.row_touched = fresh.row_touched
        this.all_touched = fresh.all_touched
        this.clip = fresh.clip
        this.force_full = fresh.force_full
        // tier stays: a reallocation is not a new terminal, so it must not
        // reset the capability detected at start(). It is not copied from
        // fresh for that reason.
        // out_buf stays. fresh.out_buf is unused, so dropping fresh neither
        // leaks nor frees this builder.
    end

    // BufReset out_buf for one serialization. Capacity stays.
    func _reset_out():
        str.BufReset(this.out_buf)
    end

    @en "ansi"
    /// The whole grid as one string of terminal output: for each row, a
    /// cursor move to its first column, then its cells, switching style
    /// only where it changes, and closing with the last style turned off.
    /// This is the entire frame; nothing is diffed against the previous one.
    pub func ansi(): str:
        this._reset_out()
        mut style := StyleDefault
        repeat this.height in y:
            str.BufAppend(this.out_buf, term.SeqMoveTo(y + 1, 1))
            repeat this.width in x:
                c := this.cells.get(y * this.width + x)
                if not StyleEq(c.style, style):
                    str.BufAppend(this.out_buf, StyleSgrOff(style, this.tier))
                    str.BufAppend(this.out_buf, StyleSgr(c.style, this.tier))
                    style = c.style
                end
                str.BufAppend(this.out_buf, c.ch)
            end
        end
        str.BufAppend(this.out_buf, StyleSgrOff(style, this.tier))
        ret str.BufStr(this.out_buf)
    end

    @en "diff"
    /// The bytes flush() would write: the whole frame (see ansi) while
    /// `force_full`, otherwise only the cells that differ from the front
    /// grid, row by row. Each maximal run of changed cells is prefixed by one
    /// cursor move; styles switch only where they change and are carried
    /// across runs; a non-empty diff ends by turning the last style off.
    /// Returns "" when the grids match.
    pub func diff(): str:
        if this.force_full:
            ret this.ansi()
        end
        this._reset_out()
        mut style := StyleDefault
        mut changed := false
        repeat this.height in y:
            if this.all_touched or this.row_touched.get(y):
                mut x := 0
                until x < this.width:
                    idx := y * this.width + x
                    marked := this.all_touched or this.touched.get(idx)
                    if not marked or this.cells.get(idx) == this.front.get(idx):
                        x += 1
                    else:
                        // Extend the run while the next cell is marked and differs.
                        mut e := x + 1
                        until e < this.width and (this.all_touched or this.touched.get(y * this.width + e)) and this.cells.get(y * this.width + e) != this.front.get(y * this.width + e):
                            e += 1
                        end
                        str.BufAppend(this.out_buf, term.SeqMoveTo(y + 1, x + 1))
                        mut i := x
                        until i < e:
                            c := this.cells.get(y * this.width + i)
                            if not StyleEq(c.style, style):
                                str.BufAppend(this.out_buf, StyleSgrOff(style, this.tier))
                                str.BufAppend(this.out_buf, StyleSgr(c.style, this.tier))
                                style = c.style
                            end
                            str.BufAppend(this.out_buf, c.ch)
                            i += 1
                        end
                        changed = true
                        x = e
                    end
                end
            end
        end
        if changed:
            str.BufAppend(this.out_buf, StyleSgrOff(style, this.tier))
        end
        ret str.BufStr(this.out_buf)
    end

    @en "commit"
    /// Copies every cell when `force_full` is set or clear() touched the
    /// whole grid, and only marked cells otherwise, then clears the marks
    /// and `force_full`, so a later diff() reports only subsequent changes.
    pub func commit():
        if this.force_full or this.all_touched:
            // ansi() left the front grid stale everywhere, or clear()
            // invalidated it.
            repeat this.cells.len() in i:
                this.front.set(i, this.cells.get(i))
            end
        else:
            repeat this.height in y:
                if this.row_touched.get(y):
                    base := y * this.width
                    repeat this.width in x:
                        i := base + x
                        if this.touched.get(i):
                            this.front.set(i, this.cells.get(i))
                        end
                    end
                end
            end
        end
        // A clear() frame wrote no marks, so there is nothing to clear.
        if not this.all_touched:
            repeat this.touched.len() in i:
                this.touched.set(i, false)
            end
            repeat this.row_touched.len() in y:
                this.row_touched.set(y, false)
            end
        end
        this.all_touched = false
        this.force_full = false
    end

    @en "flush"
    /// Writes the changed cells (see diff) to the terminal, then commits so
    /// the front grid matches the back grid. Nothing is written when the
    /// diff is empty.
    pub func flush():
        out := this.diff()
        if out != "":
            term.Emit(out)
        end
        this.commit()
    end

    @en "free"
    /// Releases both grids. Call it once, on the original Buffer, when you
    /// are done with it; copies share the storage.
    pub func free():
        this.cells.free()
        this.front.free()
        this.touched.free()
        this.row_touched.free()
        str.BufFree(this.out_buf)
    end
end

@en "NewBuffer"
/// Creates a blank width x height buffer whose clip covers the whole grid and
/// whose next diff() is a full frame. A negative size is treated as zero.
pub func NewBuffer(width: int, height: int): Buffer:
    w := width < 0 ? 0 : width
    h := height < 0 ? 0 : height
    // Private fields can only be set from a method or this literal.
    mut cells := Vector {} as Vector<Cell>
    mut front := Vector {} as Vector<Cell>
    mut touched := Vector {} as Vector<bool>
    mut row_touched := Vector {} as Vector<bool>
    repeat w * h:
        cells.push(Cell {})
        front.push(Cell {})
        touched.push(false)
    end
    repeat h:
        row_touched.push(false)
    end
    mut b := Buffer {
        width = w
        height = h
        cells = cells
        front = front
        touched = touched
        row_touched = row_touched
    }
    b.clip = b.area()
    ret b
end
