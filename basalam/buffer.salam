/*
 * Buffer: the drawing surface widgets render into.
 *
 * Two grids of width x height Cells, each cell one codepoint plus a style:
 * `cells` is the back grid widgets draw into; `front` is the front grid,
 * what the terminal currently shows. Widgets never write the front grid;
 * only commit() advances it.
 *
 * Output. diff() serializes what changed: while `force_full` it is the whole
 * frame (ansi semantics); otherwise it walks the back grid row by row and
 * emits only the maximal runs of cells that differ from the front grid, one
 * cursor move per run, carrying one style variable across runs and closing
 * any non-empty diff with term.Reset. It returns "" when nothing changed.
 * flush() emits that diff (skipping the write when it is empty) and commits.
 *
 *   present:  the back and front grids and the cell access they need
 *             (set/get); text and rect helpers (put_str/fill); clear;
 *             resize (reallocates both grids and forces a full repaint);
 *             per-row text for tests (row_text); clipping; a render-context
 *             flag (focused); and output: ansi() serializes the WHOLE grid
 *             (cursor moves via term.SeqMoveTo, a term.Reset + style
 *             whenever the style changes) while diff()/commit() write only
 *             the cells that changed since the last commit.
 *
 *   still absent: dirty regions and rectangle tracking (CUR-212); structured
 *             styles (style is a raw SGR string from std/term, epic 7); wide
 *             characters (a cell holds one codepoint and is assumed to be one
 *             column wide) and cursor placement for text input (epic 2
 *             follow-ups).
 *
 *   contract to keep: Widget.render receives a Buffer by value, writes
 *             through it reach the screen's grid, and `clip` / `focused`
 *             are per-copy render context set by Screen.draw.
 *
 * Why widgets never touch the terminal: widgets draw here, the screen
 * decides when and how a frame reaches the terminal. That keeps rendering
 * testable without a tty (row_text / get inspect the result) and lets the
 * output strategy change without touching any widget.
 *
 * Value semantics. A Buffer is passed to Widget.render by value, but both
 * grids live in Vectors, and copies of a Vector share storage. Writing a
 * cell through any copy writes the screen's one back grid, and commit()
 * through any copy advances the shared front grid. The scalar fields (clip,
 * focused, force_full) are per-copy: the screen hands each widget its own
 * copy with `clip` set to that widget's visible area and `focused` set when
 * it holds the focus. Only the owner of the original may resize, free, or
 * flush it.
 */

package basalam

import str
import term

@en "Cell"
/// One terminal cell: a single codepoint and the style it is drawn with.
pub struct Cell:
    @en "ch"
    /// The character, exactly one codepoint. A blank cell holds " ".
    pub ch: str = " "

    @en "style"
    /// SGR escape sequence(s) to draw the cell with, built with std/term
    /// (for example term.Sgr(term.StyleBold) + term.Sgr(term.FgRed)).
    /// "" means the terminal's default style.
    pub style: str = ""
end

@en "Buffer"
/// A grid of cells that widgets draw into. Writes outside `clip` (or
/// outside the grid) are silently ignored, so drawing is infallible.
pub struct Buffer:
    @en "width"
    /// Number of columns.
    pub width: int = 0

    @en "height"
    /// Number of rows.
    pub height: int = 0

    @en "cells"
    /// Row-major cell storage: the cell at (x, y) is cells[y * width + x].
    /// Prefer get and set, which bounds-check and clip.
    pub cells: Vector<Cell> = Vector {}

    @en "front"
    /// The front grid: what the terminal currently shows. Same length and
    /// layout as `cells`. Widgets never write it; only commit() advances it.
    pub front: Vector<Cell> = Vector {}

    @en "clip"
    /// Writes outside this rect are dropped. NewBuffer sets it to the whole
    /// grid; the screen narrows it to each widget's bounds while that
    /// widget renders.
    pub clip: Rect = Rect {}

    @en "focused"
    /// Render context: true while the screen renders the focused widget,
    /// so the widget can draw a focus indicator. Always false outside a
    /// screen-driven render.
    pub focused: bool = false

    @en "force_full"
    /// True when the next diff() must serialize the whole frame instead of
    /// only the changed cells. NewBuffer and resize set it; commit() clears
    /// it once the front grid has caught up with the back grid.
    pub force_full: bool = true

    // ansi()/diff() scratch. BufReset keeps the capacity; BufStr clones, so
    // the returned str does not alias it. resize() keeps this builder.
    // Only free() releases it. A copy shares data and has its own len, so
    // only the owner may serialize.
    out_buf: str.StringBuilder = str.StringBuilder {}

    @en "area"
    /// The rect covering the whole grid: (0, 0, width, height).
    pub func area(): Rect:
        ret Rect { width = this.width, height = this.height }
    end

    @en "set"
    /// Writes one cell. Does nothing when (x, y) is outside the grid or
    /// outside `clip`.
    pub func set(x: int, y: int, cell: Cell):
        p := Point { x = x, y = y }
        if not this.area().contains(p) or not this.clip.contains(p):
            ret
        end
        this.cells.set(y * this.width + x, cell)
    end

    @en "get"
    /// Reads one cell. Returns a blank default Cell when (x, y) is outside
    /// the grid. Reading ignores `clip`.
    pub func get(x: int, y: int): Cell:
        p := Point { x = x, y = y }
        if not this.area().contains(p):
            ret Cell {}
        end
        ret this.cells.get(y * this.width + x)
    end

    @en "put_str"
    /// Writes text left to right starting at (x, y), one codepoint per
    /// cell, all in the same style. Text that runs past the clip or the
    /// grid is cut off; it never wraps.
    pub func put_str(x: int, y: int, text: str, style: str):
        mut i := 0
        mut col := 0
        n := text.len()
        until i < n:
            ch := str.CharAt(text, i)
            if ch == "":
                break
            end
            this.set(x + col, y, Cell { ch = ch, style = style })
            col += 1
            i += ch.len()
        end
    end

    @en "fill"
    /// Sets every cell of r (clipped) to the same character and style.
    pub func fill(r: Rect, ch: str, style: str):
        repeat r.height in dy:
            repeat r.width in dx:
                this.set(r.x + dx, r.y + dy, Cell { ch = ch, style = style })
            end
        end
    end

    @en "clear"
    /// Resets every cell of the grid to a blank default Cell, ignoring
    /// `clip`.
    pub func clear():
        repeat this.cells.len() in i:
            this.cells.set(i, Cell {})
        end
    end

    @en "row_text"
    /// The characters of row y joined into one string, without styles.
    /// Returns "" for a row outside the grid. Meant for tests and debugging.
    pub func row_text(y: int): str:
        if y < 0 or y >= this.height:
            ret ""
        end
        mut b := str.NewBuilder()
        defer str.BufFree(b)
        repeat this.width in x:
            str.BufAppend(b, this.cells.get(y * this.width + x).ch)
        end
        ret str.BufStr(b)
    end

    @en "resize"
    /// Replaces both grids with blank width x height ones and resets clip to
    /// cover them, forcing a full repaint on the next diff(). Only the owner
    /// of the original Buffer may call this: it frees the old storage that
    /// copies were sharing.
    pub func resize(width: int, height: int):
        this.cells.free()
        this.front.free()
        fresh := NewBuffer(width, height)
        this.width = fresh.width
        this.height = fresh.height
        this.cells = fresh.cells
        this.front = fresh.front
        this.clip = fresh.clip
        this.force_full = fresh.force_full
        // out_buf stays. fresh.out_buf is unused, so dropping fresh neither
        // leaks nor frees this builder.
    end

    // BufReset out_buf for one serialization. Capacity stays.
    func _reset_out():
        str.BufReset(this.out_buf)
    end

    @en "ansi"
    /// The whole grid as one string of terminal output: for each row, a
    /// cursor move to its first column, then its cells, switching style
    /// only where it changes, and a final style reset. This is the entire
    /// frame; nothing is diffed against the previous one.
    pub func ansi(): str:
        this._reset_out()
        mut style := ""
        repeat this.height in y:
            str.BufAppend(this.out_buf, term.SeqMoveTo(y + 1, 1))
            repeat this.width in x:
                c := this.cells.get(y * this.width + x)
                if c.style != style:
                    str.BufAppend(this.out_buf, term.Reset)
                    str.BufAppend(this.out_buf, c.style)
                    style = c.style
                end
                str.BufAppend(this.out_buf, c.ch)
            end
        end
        str.BufAppend(this.out_buf, term.Reset)
        ret str.BufStr(this.out_buf)
    end

    @en "diff"
    /// The bytes flush() would write: the whole frame (see ansi) while
    /// `force_full`, otherwise only the cells that differ from the front
    /// grid, row by row. Each maximal run of changed cells is prefixed by one
    /// cursor move; styles switch only where they change and are carried
    /// across runs; a non-empty diff ends with term.Reset. Returns "" when
    /// the grids match.
    pub func diff(): str:
        if this.force_full:
            ret this.ansi()
        end
        this._reset_out()
        mut style := ""
        mut changed := false
        repeat this.height in y:
            mut x := 0
            until x < this.width:
                if this.cells.get(y * this.width + x) == this.front.get(y * this.width + x):
                    x += 1
                else:
                    // Extend the run while the cells keep differing.
                    mut e := x + 1
                    until e < this.width and this.cells.get(y * this.width + e) != this.front.get(y * this.width + e):
                        e += 1
                    end
                    str.BufAppend(this.out_buf, term.SeqMoveTo(y + 1, x + 1))
                    mut i := x
                    until i < e:
                        c := this.cells.get(y * this.width + i)
                        if c.style != style:
                            str.BufAppend(this.out_buf, term.Reset)
                            str.BufAppend(this.out_buf, c.style)
                            style = c.style
                        end
                        str.BufAppend(this.out_buf, c.ch)
                        i += 1
                    end
                    changed = true
                    x = e
                end
            end
        end
        if changed:
            str.BufAppend(this.out_buf, term.Reset)
        end
        ret str.BufStr(this.out_buf)
    end

    @en "commit"
    /// Copies the back grid into the front grid cell by cell and clears
    /// `force_full`, so a later diff() reports only subsequent changes.
    pub func commit():
        repeat this.cells.len() in i:
            this.front.set(i, this.cells.get(i))
        end
        this.force_full = false
    end

    @en "flush"
    /// Writes the changed cells (see diff) to the terminal, then commits so
    /// the front grid matches the back grid. Nothing is written when the
    /// diff is empty.
    pub func flush():
        out := this.diff()
        if out != "":
            term.Emit(out)
        end
        this.commit()
    end

    @en "free"
    /// Releases both grids. Call it once, on the original Buffer, when you
    /// are done with it; copies share the storage.
    pub func free():
        this.cells.free()
        this.front.free()
        str.BufFree(this.out_buf)
    end
end

@en "NewBuffer"
/// Creates a blank width x height buffer whose clip covers the whole grid and
/// whose next diff() is a full frame. A negative size is treated as zero.
pub func NewBuffer(width: int, height: int): Buffer:
    w := width < 0 ? 0 : width
    h := height < 0 ? 0 : height
    mut b := Buffer { width = w, height = h }
    b.clip = b.area()
    repeat w * h:
        b.cells.push(Cell {})
        b.front.push(Cell {})
    end
    ret b
end
