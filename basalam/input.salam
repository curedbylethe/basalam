/*
 * Input: a single-line text-entry widget.
 *
 * Input holds a value, a caret index into that value, and three styles. It is
 * focusable, so the screen routes keyboard events to it; its handle_event
 * inserts printable characters and spaces at the caret, moves the caret with
 * Left/Right/Home/End, deletes with Backspace (before the caret) and Delete
 * (at the caret), and consumes enter without changing anything (submitting
 * belongs to the host, which reads value()).
 *
 * Cells, not bytes. The value and the caret are counted in codepoints, using
 * str.Chars/CharCount/CharSubstr, so a multibyte glyph is one cell and one
 * caret step.
 *
 * Rendering is stateful. The widget stores the index of the first visible
 * codepoint (window_start) between frames; each render shows the full width
 * and moves the window the minimum needed to keep the caret inside it, so the
 * caret column is always 0..width-1 and no cell is reserved for it. The
 * cursor is drawn as one reverse-video cell over whatever glyph the row
 * already has at the caret column (a blank past the last glyph), and only
 * while the buffer reports focus. An empty value shows the placeholder,
 * styled dim, whether focused or not.
 *
 * This file deliberately has no layout measurement, no selection or paste,
 * no submit callback, and no Buffer cursor API. The
 * fields are complete Style values: StyleDefault on `style` asks for the
 * terminal's default, and StyleDefault on `cursor_style` or
 * `placeholder_style` adds nothing. The cursor and placeholder compose over
 * the base with StyleMerge — their colors win, their attributes are ORed —
 * so a caller can ask for a plain cursor by assigning StyleDefault. Placement
 * in the parent's box belongs to whoever owns the layout.
 */

package basalam

import str
import term

@en "Input"
@fa "ورودی"
/// A single-line text input: value, caret, optional placeholder, and styles
/// for the value, the cursor cell, and the placeholder. It is focusable, so
/// keyboard events reach it through the screen's focus dispatch. Set the
/// value with the field or set_value, read it with value, and set the
/// placeholder with the field or set_placeholder.
pub struct Input:
    pub use BaseWidget

    @en "placeholder"
    @fa "متن راهنما"
    /// Text shown (dim) while the value is empty. "" means no placeholder.
    pub placeholder: str = ""

    @en "style"
    @fa "ظاهر"
    /// The base style of the value and the blank background. StyleDefault
    /// draws with the terminal's defaults.
    pub style: Style = StyleDefault

    @en "cursor_style"
    @fa "ظاهر مکان‌نما"
    /// The style merged over `style` for the cursor cell. Defaults to
    /// reverse video.
    pub cursor_style: Style = Style { reverse = true }

    @en "placeholder_style"
    @fa "ظاهر متن راهنما"
    /// The style merged over `style` for the placeholder. Defaults to a
    /// bright-black foreground.
    pub placeholder_style: Style = Style { fg = BrightBlack }

    content: str = ""
    caret: int = 0
    window_start: int = 0

    @en "focusable"
    @fa "تمرکز‌پذیر است"
    /// Returns true: Input is interactive, so the screen's focus dispatch
    /// routes keyboard events to it.
    pub func focusable(): bool:
        ret true
    end

    @en "handle_event"
    @fa "پردازش رویداد"
    /// Reacts to a key press. A printable character or space is inserted at
    /// the caret; Left, Right, Home and End move it (all consumed, even when
    /// it cannot move); backspace drops the codepoint before the caret and
    /// delete the one at it (nothing at the start or end); enter is consumed
    /// without changing anything. Other events and keys are not consumed, so
    /// they bubble on.
    pub func handle_event(event: Event): bool:
        if event.kind != KeyEvent:
            ret false
        end
        code := event.key.code
        total := str.CharCount(this.content)
        if code == term.KeyChar and not event.key.ctrl and not event.key.alt:
            this.content = str.CharSubstr(this.content, 0, this.caret) + event.key.ch + str.CharSubstr(this.content, this.caret, total - this.caret)
            this.caret = this.caret + 1
            ret true
        end
        if code == term.KeySpace:
            this.content = str.CharSubstr(this.content, 0, this.caret) + " " + str.CharSubstr(this.content, this.caret, total - this.caret)
            this.caret = this.caret + 1
            ret true
        end
        if code == term.KeyLeft:
            if this.caret > 0:
                this.caret = this.caret - 1
            end
            ret true
        end
        if code == term.KeyRight:
            if this.caret < total:
                this.caret = this.caret + 1
            end
            ret true
        end
        if code == term.KeyHome:
            this.caret = 0
            ret true
        end
        if code == term.KeyEnd:
            this.caret = total
            ret true
        end
        if code == term.KeyBackspace:
            if this.caret > 0:
                this.content = str.CharSubstr(this.content, 0, this.caret - 1) + str.CharSubstr(this.content, this.caret, total - this.caret)
                this.caret = this.caret - 1
            end
            ret true
        end
        if code == term.KeyDelete:
            if this.caret < total:
                this.content = str.CharSubstr(this.content, 0, this.caret) + str.CharSubstr(this.content, this.caret + 1, total - this.caret - 1)
            end
            ret true
        end
        if code == term.KeyEnter:
            ret true
        end
        ret false
    end

    @en "value"
    @fa "مقدار"
    /// The current text, without styles.
    pub func value(): str:
        ret this.content
    end

    @en "set_value"
    @fa "تنظیم مقدار"
    /// Replaces the value; the caret moves to its end.
    pub func set_value(v: str):
        this.content = v
        this.caret = str.CharCount(v)
    end

    @en "set_placeholder"
    @fa "تنظیم متن راهنما"
    /// Sets the text shown while the value is empty.
    pub func set_placeholder(p: str):
        this.placeholder = p
    end

    @en "render"
    @fa "ترسیم"
    /// Draws the value into bounds: the box is painted with `style`, the
    /// window of cells that holds the caret is written (the placeholder,
    /// dim, when the value is empty), and — while the buffer reports focus —
    /// one reverse-video cell marks the caret column. The window start is
    /// kept between frames and moves only when the caret leaves it. A
    /// degenerate box draws nothing and never panics.
    pub func render(buf: Buffer, bounds: Rect):
        if bounds.is_empty():
            ret
        end
        buf.fill(bounds, " ", this.style)
        w := bounds.width
        count := str.CharCount(this.content)
        if this.caret < this.window_start:
            this.window_start = this.caret
        else this.caret > this.window_start + w - 1:
            this.window_start = this.caret - w + 1
        end
        start := this.window_start
        if count == 0 and this.placeholder != "":
            ps := StyleMerge(this.style, this.placeholder_style)
            buf.put_str(bounds.x, bounds.y, str.CharSubstr(this.placeholder, 0, w), ps)
        else:
            mut shown := count - start
            if shown > w:
                shown = w
            end
            buf.put_str(bounds.x, bounds.y, str.CharSubstr(this.content, start, shown), this.style)
        end
        if buf.focused:
            col := this.caret - start
            c := buf.get(bounds.x + col, bounds.y)
            buf.set(bounds.x + col, bounds.y, Cell { ch = c.ch, style = StyleMerge(this.style, this.cursor_style) })
        end
    end
end

@en "NewInput"
@fa "ورودی جدید"
/// Creates an empty Input with no placeholder, unstyled values, and the
/// default cursor and placeholder styles.
pub func NewInput(): Input:
    ret Input {}
end
