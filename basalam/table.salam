/*
 * Table: a non-focusable grid of single-line rows, with an optional bold
 * header, a rule under the header, per-column and per-cell alignment, and
 * clip or ellipsis overflow.
 *
 * Column widths reuse LayoutSize: Fixed is an exact width, Pref is the
 * content width plus 2 * pad_x clamped to [min, max], and Fill is a weighted
 * share of what is left. When the rect is narrower than the table, star
 * columns shrink to 0 first, then Pref columns shrink toward min, and Fixed
 * columns keep their width and are clipped by the rect from the right.
 *
 * Widths are resolved on every call (render, preferred_size and measure use
 * the same helper, so they agree). That is cheap for a first version. A cache
 * belongs in set_bounds if a profile ever asks for one.
 *
 * Cells cost the display width of their codepoints, where East Asian wide
 * glyphs count 2 (term.Width counts codepoints, so it cannot answer that).
 * A wide glyph that would be split at an edge is replaced by a blank cell.
 * Each cell paints its own rect and nothing else: the table's remainder is
 * not painted, so it stays transparent over whatever lies beneath it.
 *
 * Deliberate omissions: no scrolling in either direction, no row selection
 * or keyboard handling, no sorting, no column resize, no borders or column
 * dividers, and no per-cell styles. Table is never a focus or click target:
 * it does not take focus, does not hit-test, and does not consume events.
 */

package basalam

import str

// A per-cell alignment override. Private: set only through set_cell_align.
struct _CellAlign:
    pub row: int = 0
    pub col: int = 0
    pub align: Alignment = Alignment.Left
end

@en "CellOverflow"
/// What happens to cell text wider than its text area.
pub enum CellOverflow:
    @en "Clip"
    /// Text past the edge is cut off (the default).
    Clip
    @en "Ellipsis"
    /// The last visible cell is replaced by the ellipsis character.
    Ellipsis
end

@en "TableColumn"
/// One column of a Table. width is read as a LayoutSize; min and max are read
/// only when width is Pref. max = -1 means unbounded. When min and max
/// conflict, min wins.
pub struct TableColumn:
    @en "width"
    /// Fixed exact cells, Pref the content width, Fill a star share.
    pub width: LayoutSize = LayoutSize {}

    @en "min"
    /// Lower bound for a Pref column, in cells.
    pub min: int = 0

    @en "max"
    /// Upper bound for a Pref column, in cells. -1 means unbounded.
    pub max: int = -1

    @en "align"
    /// Default alignment of this column's cells and header.
    pub align: Alignment = Alignment.Left

    @en "overflow"
    /// How text wider than the column is shown.
    pub overflow: CellOverflow = CellOverflow.Clip
end

@en "Table"
/// A non-focusable grid of single-line rows. Add columns and rows, then
/// render it. When header is on, row 0 is the header: it is painted in
/// header_style and each cell takes its column's alignment. rule draws a
/// line of ─ under the header across the table's width. pad_x is the blank
/// space on each side of a cell; a negative value counts as 0.
pub struct Table:
    pub use BaseWidget

    @en "columns"
    /// The column definitions, left to right.
    pub columns: Vector<TableColumn> = Vector {}

    @en "rows"
    /// The cell text by row, then column. Row 0 is the header when header is on.
    pub rows: Vector<Vector<str>> = Vector {}

    @en "header"
    /// When true, row 0 is the header.
    pub header: bool = false

    @en "rule"
    /// Draws a rule under the header. Only meaningful when header is on.
    pub rule: bool = true

    @en "pad_x"
    /// Blank cells on each side of every cell's text.
    pub pad_x: int = 1

    @en "style"
    /// Style of the data rows.
    pub style: Style = StyleDefault

    @en "header_style"
    /// Style of the header row. It replaces style there, rather than merging.
    pub header_style: Style = Style { bold = true }

    cell_aligns: Vector<_CellAlign> = Vector {}

    @en "focusable"
    /// Returns false: a table takes no keyboard focus.
    pub func focusable(): bool:
        ret false
    end

    @en "hits"
    /// Returns false: a click on the table falls through to whatever is beneath.
    pub func hits(): bool:
        ret false
    end

    @en "handle_event"
    /// Consumes nothing and changes nothing.
    pub func handle_event(event: Event): bool:
        _ := event
        ret false
    end

    @en "add_column"
    /// Appends a column and returns its index.
    pub func add_column(col: TableColumn): int:
        this.columns.push(col)
        ret this.columns.len() - 1
    end

    @en "add_row"
    /// Appends a row and returns its index. Missing cells read as blank.
    pub func add_row(cells: Vector<str>): int:
        this.rows.push(cells)
        ret this.rows.len() - 1
    end

    @en "set_column_width"
    /// Sets a column's width rule. An index out of range does nothing.
    pub func set_column_width(i: int, w: LayoutSize):
        if i < 0 or i >= this.columns.len():
            ret
        end
        mut col := this.columns.get(i)
        col.width = w
        this.columns.set(i, col)
    end

    @en "set_column_align"
    /// Sets a column's default alignment. An index out of range does nothing.
    pub func set_column_align(i: int, a: Alignment):
        if i < 0 or i >= this.columns.len():
            ret
        end
        mut col := this.columns.get(i)
        col.align = a
        this.columns.set(i, col)
    end

    @en "set_column_overflow"
    /// Sets a column's overflow. An index out of range does nothing.
    pub func set_column_overflow(i: int, o: CellOverflow):
        if i < 0 or i >= this.columns.len():
            ret
        end
        mut col := this.columns.get(i)
        col.overflow = o
        this.columns.set(i, col)
    end

    @en "set_cell_align"
    /// Overrides the alignment of one cell. It beats the column's alignment,
    /// which beats Left. Row is an index into rows, so 0 is the header when
    /// header is on.
    pub func set_cell_align(row: int, col: int, a: Alignment):
        repeat this.cell_aligns.len() in k:
            mut o := this.cell_aligns.get(k)
            if o.row == row and o.col == col:
                o.align = a
                this.cell_aligns.set(k, o)
                ret
            end
        end
        this.cell_aligns.push(_CellAlign { row = row, col = col, align = a })
    end

    @en "set_pad_x"
    /// Sets the blank space on each side of a cell. A negative value counts as 0.
    pub func set_pad_x(n: int):
        this.pad_x = n
    end

    @en "preferred_size"
    /// The table's natural size: the resolved widths with star columns at 0,
    /// clamped to max_width when it is positive. The height is the header,
    /// the rule and the data rows, so a table with no rows is 0 high. A table
    /// with no columns is 0 by 0.
    pub func preferred_size(max_width: int): Rect:
        if this.columns.len() == 0:
            ret Rect { width = 0, height = 0 }
        end
        ws := this._resolve_widths(-1)
        mut total := 0
        repeat ws.len() in i:
            total = total + ws.get(i)
        end
        if max_width > 0 and total > max_width:
            total = max_width
        end
        ret Rect { width = total, height = this._height() }
    end

    @en "measure"
    /// Reports the preferred size along axis. ok is always true, so the
    /// layout engine reads a real answer.
    pub func measure(axis: Axis, max_width: int): Measure:
        size := this.preferred_size(max_width)
        if axis == Axis.X:
            ret Measure { ok = true, extent = size.width }
        end
        ret Measure { ok = true, extent = size.height }
    end

    @en "render"
    /// Draws the table into bounds. Rows past bounds.height are not drawn.
    /// Nothing is drawn for an empty table or an empty rect.
    pub func render(buf: Buffer, bounds: Rect):
        if bounds.is_empty() or this.columns.len() == 0 or this.rows.len() == 0:
            ret
        end
        ws := this._resolve_widths(bounds.width)
        body := StyleSgr(this.style, ColorTier.TrueColor)
        head := StyleSgr(this.header_style, ColorTier.TrueColor)
        mut y := 0
        mut first := 0
        if this.header:
            if y < bounds.height:
                this._paint_row(buf, bounds, ws, 0, y, head)
            end
            y = y + 1
            first = 1
        end
        if this.header and this.rule:
            if y < bounds.height:
                this._paint_rule(buf, bounds, ws, y, body)
            end
            y = y + 1
        end
        repeat this.rows.len() - first in k:
            if y < bounds.height:
                this._paint_row(buf, bounds, ws, first + k, y, body)
            end
            y = y + 1
        end
    end

    // Column widths for a rect w cells wide. w < 0 means no width is given:
    // star columns resolve to 0 and nothing shrinks. That is the preferred size.
    func _resolve_widths(w: int): Vector<int>:
        n := this.columns.len()
        pad := this._pad()
        mut out := Vector {} as Vector<int>
        repeat n in i:
            col := this.columns.get(i)
            mut v := 0
            if col.width.kind == SizeKind.Fixed:
                v = col.width.cells
                if v < 0:
                    v = 0
                end
            else col.width.kind == SizeKind.Pref:
                v = this._natural(i) + 2 * pad
                mut lo := col.min
                if lo < 0:
                    lo = 0
                end
                if col.max >= 0 and v > col.max:
                    v = col.max
                end
                if v < lo:
                    v = lo
                end
            end
            out.push(v)
        end
        if w < 0:
            ret out
        end
        mut used := 0
        repeat n in i:
            used = used + out.get(i)
        end
        if used > w:
            // Too narrow even without star columns: Pref columns shrink toward
            // min, left to right. Fixed columns keep their width and are
            // clipped by the rect at paint time.
            mut over := used - w
            repeat n in i:
                col := this.columns.get(i)
                if over > 0 and col.width.kind == SizeKind.Pref:
                    mut lo := col.min
                    if lo < 0:
                        lo = 0
                    end
                    mut take := out.get(i) - lo
                    if take < 0:
                        take = 0
                    end
                    if take > over:
                        take = over
                    end
                    out.set(i, out.get(i) - take)
                    over = over - take
                end
            end
            ret out
        end
        // Star columns share what is left, by weight. Each gets its floor
        // share, and the integer remainder goes one cell each to the earliest
        // weighted star columns.
        free_cells := w - used
        mut wsum := 0
        repeat n in i:
            col := this.columns.get(i)
            if col.width.kind == SizeKind.Fill and col.width.weight > 0:
                wsum = wsum + col.width.weight
            end
        end
        if wsum == 0:
            ret out
        end
        mut given := 0
        repeat n in i:
            col := this.columns.get(i)
            if col.width.kind == SizeKind.Fill and col.width.weight > 0:
                share := free_cells * col.width.weight / wsum
                out.set(i, share)
                given = given + share
            end
        end
        mut extra := free_cells - given
        repeat n in i:
            col := this.columns.get(i)
            if extra > 0 and col.width.kind == SizeKind.Fill and col.width.weight > 0:
                out.set(i, out.get(i) + 1)
                extra = extra - 1
            end
        end
        ret out
    end

    // Height in rows: header, rule, then data rows. No columns or no rows is 0.
    func _height(): int:
        if this.columns.len() == 0 or this.rows.len() == 0:
            ret 0
        end
        mut h := 0
        mut data := this.rows.len()
        if this.header:
            h = 1
            data = data - 1
            if this.rule:
                h = h + 1
            end
        end
        ret h + data
    end

    // The text of cell (r, c), or "" when the row is shorter than c.
    func _cell_text(r: int, c: int): str:
        row := this.rows.get(r)
        if c >= row.len():
            ret ""
        end
        ret _first_line(row.get(c))
    end

    // The widest content of column c across all rows, in cells.
    func _natural(c: int): int:
        mut best := 0
        repeat this.rows.len() in r:
            w := _text_width(this._cell_text(r, c))
            if w > best:
                best = w
            end
        end
        ret best
    end

    func _pad(): int:
        if this.pad_x < 0:
            ret 0
        end
        ret this.pad_x
    end

    // Cell > column > Left.
    func _align_for(r: int, c: int): Alignment:
        repeat this.cell_aligns.len() in k:
            o := this.cell_aligns.get(k)
            if o.row == r and o.col == c:
                ret o.align
            end
        end
        if c < this.columns.len():
            ret this.columns.get(c).align
        end
        ret Alignment.Left
    end

    func _paint_row(buf: Buffer, bounds: Rect, ws: Vector<int>, r: int, y: int, sgr: str):
        pad := this._pad()
        mut x := 0
        repeat this.columns.len() in c:
            w := ws.get(c)
            mut cw := w
            if cw > bounds.width - x:
                cw = bounds.width - x
            end
            if cw > 0:
                cell := Rect { x = bounds.x + x, y = bounds.y + y, width = cw, height = 1 }
                buf.fill(cell, " ", sgr)
                area := cw - 2 * pad
                mut text := ""
                if area > 0:
                    overflow := this.columns.get(c).overflow
                    text = _fit(this._cell_text(r, c), area, overflow)
                end
                mut offset := 0
                slack := area - _text_width(text)
                align := this._align_for(r, c)
                if align == Alignment.Right:
                    offset = slack
                else align == Alignment.Center:
                    offset = slack / 2
                end
                buf.put_str(cell.x + pad + offset, cell.y, text, sgr)
            end
            x = x + w
        end
    end

    func _paint_rule(buf: Buffer, bounds: Rect, ws: Vector<int>, y: int, sgr: str):
        mut total := 0
        repeat ws.len() in i:
            total = total + ws.get(i)
        end
        if total > bounds.width:
            total = bounds.width
        end
        buf.fill(Rect { x = bounds.x, y = bounds.y + y, width = total, height = 1 }, "─", sgr)
    end
end

// The text of a cell up to its first newline. Cells are single-line.
func _first_line(s: str): str:
    k := s.find("\n")
    if k >= 0:
        ret str.Substr(s, 0, k)
    end
    ret s
end

// Display cells of s.
func _text_width(s: str): int:
    cps := str.CodePoints(s)
    mut w := 0
    repeat cps.len() in i:
        w = w + _cell_width(cps.get(i))
    end
    ret w
end

// Text fitted to exactly n cells when it is cut: clipped, or clipped to n - 1
// cells and followed by the ellipsis. Text that already fits is returned as is.
// A wide glyph that would be split at the edge leaves a blank cell instead.
func _fit(s: str, n: int, overflow: CellOverflow): str:
    if n <= 0:
        ret ""
    end
    if _text_width(s) <= n:
        ret s
    end
    if overflow == CellOverflow.Ellipsis:
        ret _clip(s, n - 1) + "…"
    end
    ret _clip(s, n)
end

// The longest prefix of s that fits in n cells, padded with blanks to n.
func _clip(s: str, n: int): str:
    cps := str.CodePoints(s)
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut used := 0
    mut stop := false
    repeat cps.len() in i:
        cp := cps.get(i)
        cw := _cell_width(cp)
        if not stop:
            if used + cw <= n:
                str.BufAppendCp(b, cp)
                used = used + cw
            else:
                stop = true
            end
        end
    end
    if used < n:
        str.BufAppend(b, str.Repeat(" ", n - used))
    end
    ret str.BufStr(b)
end

@en "NewTable"
/// Creates an empty Table: no columns, no rows, no header, a rule, pad_x 1.
pub func NewTable(): Table:
    ret Table {}
end
